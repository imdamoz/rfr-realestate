---
// Al Hamra Village area guide. Copy lives in ../al-hamra-village-main.html;
// the listing cards (same markup as /listings) are rendered here from
// data.js at build time, so they can't drift from the rest of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import rawHtml from "../al-hamra-village-main.html?raw";
import { RFR as R } from "../data.js";

const SITE = "https://www.rfrrealestate.com";
const PAGE = `${SITE}/al-hamra-village`;
const AREA = "al-hamra-village";
const area = R.areas.find((a) => a.slug === AREA);

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const aed = (n) => "AED " + Number(n).toLocaleString("en-US");
const SAVE_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>';

const listings = R.listings.filter((l) => l.area === AREA);
if (!listings.length) throw new Error("al-hamra-village: no listings in data.js");

function listingCard(l) {
  const cat = l.offplan ? "Off-plan" : l.cat === "rent" ? "Rent" : "Buy";
  const price = l.price == null
    ? "<span>Price on request</span>"
    : `<span class="price" data-aed="${l.price}">${aed(l.price)}</span>${l.cat === "rent" ? " <small>/ yr</small>" : ""}`;
  const facts = [l.beds ? `${l.beds} bed` : "Studio", l.baths ? `${l.baths} bath` : null, l.sqft ? `${Number(l.sqft).toLocaleString("en-US")} sq ft` : null].filter(Boolean).join(" &middot; ");
  const gal = l.gkey ? ` lgal" data-gallery="${esc(l.gkey)}` : "";
  return `        <article class="lcard rv" id="${esc(l.slug)}" data-slug="${esc(l.slug)}">
          <a class="lcard-link roll-host" href="listings.html#${esc(l.slug)}">
            <figure class="media${gal}"><img src="${esc(l.imgs[0])}" alt="${esc(l.title)}, ${esc(area.name)}" loading="lazy"><span class="ltag">${esc(l.status)}</span></figure>
            <p class="lmeta">${cat} &mdash; ${esc(area.name)}</p>
            <h3 class="lname"><span class="roll">${esc(l.title)}</span></h3>
            <p class="lprice">${price}</p>
            <p class="lfacts">${facts}</p>
          </a>
          <button class="save" type="button" data-save="${esc(l.slug)}" aria-pressed="false" aria-label="Save ${esc(l.title)}">${SAVE_SVG}<span>Save</span></button>
        </article>`;
}

const mainHtml = rawHtml.replace("<!--RFR:LISTING_CARDS-->", listings.map(listingCard).join("\n"));
if (mainHtml.includes("<!--RFR:")) throw new Error("al-hamra-village: card placeholder not replaced");

const listItem = (i, name, url) => ({ "@type": "ListItem", position: i + 1, name, url });

const faq = [
  ["Where is Al Hamra Village?", "On the Al Hamra coast of Ras Al Khaimah, UAE. It is the closest established community to Al Marjan Island, about 12 minutes away, and about 50 minutes from Dubai airport (DXB)."],
  ["Can foreigners buy property in Al Hamra Village?", "Yes. Al Hamra Village is one of the designated freehold areas listed by Ras Al Khaimah Municipality, so foreign buyers can own property there outright."],
  ["How much does property in Al Hamra Village cost?", "Apartments start from about AED 500K, and townhouses and villas run about AED 1.5–5M. Ranges are indicative, not a valuation; we send exact figures for any unit."],
  ["What does it cost to rent in Al Hamra Village?", "One-bedrooms rent for about AED 45–65K a year and three-bedroom villas for about AED 110–160K a year. The furnished one-bedroom we list on Falcon Island is AED 65,500 a year."],
  ["What rental yield can you get in Al Hamra Village?", "Indicative gross yields are 7–8.5%. With Downtown RAK, it shows the highest indicative gross yields in our book, ahead of Al Marjan Island and Mina Al Arab."],
  ["Is Al Hamra Village good for families?", "Yes. With Mina Al Arab it is one of the two most family-led areas we cover, with schools, villas and townhouses nearby, plus a golf course and marina."],
  ["Does RFR sell and rent homes in Al Hamra Village?", "Yes. RFR Real Estate & Advisory works only in Ras Al Khaimah, and Al Hamra Village is one of the four areas we cover, with Al Marjan Island, Mina Al Arab and Downtown RAK. We help you buy, sell, rent or let there, and can manage the home once you own it."],
];

const ldJson = [
  {"@context":"https://schema.org","@graph":[{"@type":["RealEstateAgent","LocalBusiness","Organization"],"@id":"https://www.rfrrealestate.com/#business","name":"RFR Real Estate & Advisory FZ-LLC","legalName":"RFR Real Estate & Advisory FZ-LLC","slogan":"Wherever you call home.","alternateName":["RFR","RFR Real Estate","RFR Real Estate & Advisory"],"url":"https://www.rfrrealestate.com/","logo":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","image":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","email":"info@rfrrealestate.com","telephone":"+971585015885","address":{"@type":"PostalAddress","addressLocality":"Ras Al Khaimah","addressRegion":"Ras Al Khaimah","addressCountry":"AE"},"areaServed":[{"@type":"AdministrativeArea","name":"Ras Al Khaimah"},{"@type":"Place","name":"Al Marjan Island"},{"@type":"Place","name":"Mina Al Arab"},{"@type":"Place","name":"Al Hamra Village"},{"@type":"Place","name":"Downtown Ras Al Khaimah"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"10:00","closes":"16:00"}],"priceRange":"AED 65,000/yr - AED 4,060,000","currenciesAccepted":"AED","knowsAbout":["Ras Al Khaimah real estate","Al Marjan Island","Off-plan property","Property management","UAE Golden Visa property investment"],"description":"RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.","disambiguatingDescription":"A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.","sameAs":["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]},{"@type":"WebSite","@id":"https://www.rfrrealestate.com/#website","name":"RFR Real Estate","alternateName":["RFR Real Estate & Advisory","RFR Real Estate & Advisory FZ-LLC","RFR","rfrrealestate.com"],"url":"https://www.rfrrealestate.com/","publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en"},
    {"@type":"BreadcrumbList","@id":`${PAGE}#breadcrumb`,"itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":`${SITE}/`},{"@type":"ListItem","position":2,"name":"Areas","item":`${SITE}/areas`},{"@type":"ListItem","position":3,"name":"Al Hamra Village","item":PAGE}]},
    {"@type":"Place","@id":`${PAGE}#place`,"name":"Al Hamra Village","url":PAGE,"description":"Ras Al Khaimah’s original master community, with an 18-hole championship golf course, a marina and yacht club, a mall and the deepest rental market in RAK. A designated freehold area and the closest established community to Al Marjan Island.","geo":{"@type":"GeoCoordinates","latitude":area.lat,"longitude":area.lng},"image":`${SITE}/${area.img}`,"containedInPlace":{"@type":"AdministrativeArea","name":"Ras Al Khaimah","containedInPlace":{"@type":"Country","name":"United Arab Emirates"}}},
    {"@type":"WebPage","@id":`${PAGE}#webpage`,"url":PAGE,"name":"Al Hamra Village, Ras Al Khaimah: homes, prices and rents","isPartOf":{"@id":`${SITE}/#website`},"publisher":{"@id":`${SITE}/#business`},"inLanguage":"en","datePublished":"2026-11-23","dateModified":"2026-11-25","primaryImageOfPage":{"@type":"ImageObject","url":`${SITE}/media/rfr/hamra-archway.jpg`},"about":{"@id":`${PAGE}#place`},"breadcrumb":{"@id":`${PAGE}#breadcrumb`}}]},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(([q, a]) => ({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":a}}))},
  {"@context":"https://schema.org","@type":"ItemList","@id":`${PAGE}#listings`,"name":"Homes listed by RFR in Al Hamra Village","url":`${PAGE}#listings`,"numberOfItems":listings.length,"itemListElement":listings.map((l, i) => listItem(i, `${l.title}, ${area.name}`, `${SITE}/listings#${l.slug}`))},
];
---
<BaseLayout page="al-hamra-village" title={"Al Hamra Village Property for Sale & Rent | RFR Real Estate"} description={"Al Hamra Village, Ras Al Khaimah: apartments, townhouses and villas for sale and rent, indicative prices, rents and yields, what's nearby, and an FAQ."} path="/al-hamra-village" ldJson={ldJson}>
<Fragment set:html={mainHtml} />
<script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
