    {"@type":"WebPage","@id":`${PAGE}#webpage`,"url":PAGE,"name":H1,"isPartOf":{"@id":`${SITE}/#website`},"publisher":{"@id":`${SITE}/#business`},"inLanguage":"en","datePublished":PUBLISHED,"dateModified":MODIFIED,"primaryImageOfPage":{"@type":"ImageObject","url":IMAGE},"breadcrumb":{"@id":`${PAGE}#breadcrumb`}},
    {"@type":"Article","@id":`${PAGE}#article`,"headline":H1,"description":"Whether buying property in Ras Al Khaimah can qualify you for a UAE Golden Visa: the AED 2,000,000 rule, mortgages and off-plan, 5 or 10 years, benefits, the steps and the documents ICP asks for, with official sources.","image":IMAGE,"datePublished":PUBLISHED,"dateModified":MODIFIED,"author":{"@id":`${SITE}/#business`},"publisher":{"@id":`${SITE}/#business`},"mainEntityOfPage":{"@id":`${PAGE}#webpage`},"inLanguage":"en","about":"UAE Golden Visa (Golden Residency) through property investment in Ras Al Khaimah","citation":["https://icp.gov.ae/en/services/uae-golden-residency/","https://icp.gov.ae/services-details/?serviceid=68e34eea5ae59b00117383d5","https://u.ae/en/information-and-services/visa-and-emirates-id/residence-visas/golden-visa"]}]},
