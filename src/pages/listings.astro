---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RFR } from "../data.js";

// Listing cards are generated from data.js at build time. The markup below
// reproduces the original static listings.html card exactly; data.js + site.js
// then power the filter bar, map, galleries and currency toggle client-side.
const areaName = (slug) => (RFR.areas.find((a) => a.slug === slug) || {}).name || "";
const typeAttr = (t) =>
  /villa/i.test(t) ? "villa" : /plot/i.test(t) ? "plot" : "apartment";
const fmt = (n) => n.toLocaleString("en-US");
const listings = RFR.listings;

const ldJson = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["RealEstateAgent", "LocalBusiness"],
        "@id": "https://www.rfrrealestate.com/#business",
        "name": "RFR Real Estate & Advisory FZ-LLC",
        "alternateName": ["RFR", "RFR Real Estate", "RFR Real Estate & Advisory"],
        "url": "https://www.rfrrealestate.com/",
        "logo": "https://www.rfrrealestate.com/media/rfr-logo-gold.webp",
        "image": "https://www.rfrrealestate.com/media/rfr-logo-gold.webp",
        "email": "info@rfrrealestate.com",
        "telephone": "+971585015885",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ras Al Khaimah",
          "addressRegion": "Ras Al Khaimah",
          "addressCountry": "AE"
        },
        "areaServed": [
          { "@type": "AdministrativeArea", "name": "Ras Al Khaimah" },
          { "@type": "Place", "name": "Al Marjan Island" },
          { "@type": "Place", "name": "Mina Al Arab" },
          { "@type": "Place", "name": "Al Hamra Village" },
          { "@type": "Place", "name": "Downtown Ras Al Khaimah" }
        ],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "18:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Saturday",
            "opens": "10:00",
            "closes": "16:00"
          }
        ],
        "priceRange": "AED 65,000/yr - AED 4,060,000",
        "currenciesAccepted": "AED",
        "knowsAbout": [
          "Ras Al Khaimah real estate",
          "Al Marjan Island",
          "Off-plan property",
          "Property management",
          "UAE Golden Visa property investment"
        ],
        "description": "RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.",
        "disambiguatingDescription": "A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.",
        "sameAs": ["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]
      },
      {
        "@type": "WebSite",
        "@id": "https://www.rfrrealestate.com/#website",
        "name": "RFR Real Estate",
        "url": "https://www.rfrrealestate.com/",
        "publisher": { "@id": "https://www.rfrrealestate.com/#business" },
        "inLanguage": "en"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.rfrrealestate.com/" },
          { "@type": "ListItem", "position": 2, "name": "Listings", "item": "https://www.rfrrealestate.com/listings" }
        ]
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What property is for sale in Ras Al Khaimah with RFR?", "acceptedAnswer": { "@type": "Answer", "text": "Ready homes and off-plan units on Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK, updated as our book changes." } },
      { "@type": "Question", "name": "Can foreigners buy property in Ras Al Khaimah?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Foreign buyers can own freehold property outright in Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK." } },
      { "@type": "Question", "name": "Which areas of Ras Al Khaimah does RFR cover?", "acceptedAnswer": { "@type": "Answer", "text": "Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK. We don't work outside Ras Al Khaimah." } },
      { "@type": "Question", "name": "How do off-plan payment plans work in Ras Al Khaimah?", "acceptedAnswer": { "@type": "Answer", "text": "Buyers pay in instalments as the building is constructed, typically on a schedule between 50/50 and 80/20, with the balance due on or near handover." } },
      { "@type": "Question", "name": "Do I need to be in the UAE to buy property in Ras Al Khaimah?", "acceptedAnswer": { "@type": "Answer", "text": "No. Many of our buyers live overseas. We run video viewings and can handle the paperwork and management once you own it." } }
    ]
  }
];
---
<BaseLayout page="listings" title="Listings | RFR Real Estate" description="Homes to buy, rent and off-plan in Ras Al Khaimah." path="/listings" ldJson={ldJson}>
  <section class="phx hx" aria-labelledby="lst-t">
    <div class="phx-bg" aria-hidden="true"><img class="is-on" src="media/rfr/apartment-living.jpg" alt="" fetchpriority="high"></div>
    <div class="wrap hx-in">
      <h1 class="giant sand hx-t" id="lst-t" data-split>Available now</h1>
      <div class="hx-block">
        <p class="hx-label">Listings &middot; Ras Al Khaimah</p>
        <p class="hx-text">We&rsquo;d show any of these to a friend. Save the ones you like and ask to see them all in one message.</p>
      </div>
      <div class="lf-slot">
      <form class="hsearch lfind" id="lf-form" role="search" aria-label="Find a home in Ras Al Khaimah" autocomplete="off" novalidate>
        <div class="lf-in">
          <div class="hs-tabs lf-tabs" role="group" aria-label="Buy, lease or off-plan">
            <button class="hs-tab on" type="button" data-f="cat" data-v="all" aria-pressed="true">All</button>
            <button class="hs-tab" type="button" data-f="cat" data-v="buy" aria-pressed="false">Buy</button>
            <button class="hs-tab" type="button" data-f="cat" data-v="rent" aria-pressed="false">Lease</button>
            <button class="hs-tab" type="button" data-f="cat" data-v="offplan" aria-pressed="false">Off-plan</button>
          </div>
          <div class="hs-box">
            <div class="hs-field">
              <svg class="hs-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
              <input class="hs-input" id="lf-q" type="text" placeholder="Community or building" aria-label="Community or building" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="lf-list" spellcheck="false">
              <button class="lf-clear" id="lf-clear" type="button" aria-label="Clear community" hidden><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8"/></svg></button>
              <ul class="hs-list" id="lf-list" role="listbox" aria-label="Suggestions" hidden></ul>
            </div>
            <button class="hs-filters" id="lf-filters" type="button" aria-expanded="false" aria-controls="lf-panel"><svg class="lf-sl" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h8.5M15.5 6H17M3 14h2.5M9.5 14H17"/><circle cx="13.5" cy="6" r="2"/><circle cx="7.5" cy="14" r="2"/></svg><span class="lf-ft">Filters</span><b class="lf-n" id="lf-n" hidden></b><svg class="lf-chev" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg></button>
            <div class="lf-view view-sw" role="group" aria-label="View">
              <button type="button" data-view="grid" aria-pressed="true" aria-label="Grid view" title="Grid"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5.5" height="5.5"/><rect x="11.5" y="3" width="5.5" height="5.5"/><rect x="3" y="11.5" width="5.5" height="5.5"/><rect x="11.5" y="11.5" width="5.5" height="5.5"/></svg></button>
              <button type="button" data-view="map" aria-pressed="false" aria-label="Map view" title="Map"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 5.2l5-2 5 2 5-2v11.6l-5 2-5-2-5 2z"/><path d="M7.5 3.2v11.6M12.5 5.2v11.6"/></svg></button>
            </div>
            <button class="hs-go" type="submit" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg></button>
          </div>
          <div class="hs-panel lf-panel" id="lf-panel" hidden>
            <div class="lf-areas" role="group" aria-label="Area"><span class="lf-lab">Area</span><div class="lf-chips"><button class="lf-chip" type="button" data-f="area" data-v="all" aria-pressed="true">All areas</button><button class="lf-chip" type="button" data-f="area" data-v="al-marjan-island" aria-pressed="false">Al Marjan Island</button><button class="lf-chip" type="button" data-f="area" data-v="mina-al-arab" aria-pressed="false">Mina Al Arab</button><button class="lf-chip" type="button" data-f="area" data-v="al-hamra-village" aria-pressed="false">Al Hamra Village</button><button class="lf-chip" type="button" data-f="area" data-v="downtown-rak" aria-pressed="false">Downtown RAK</button></div></div>
            <label><span>Type</span><select id="f-type"><option value="">Any</option><option value="apartment">Apartment</option><option value="villa">Villa</option><option value="plot">Plot</option></select></label>
            <label><span>Min budget</span><select id="f-min"></select></label>
            <label><span>Max budget</span><select id="f-max"></select></label>
            <label><span>Beds</span><select id="f-beds"><option value="">Any</option><option value="0">Studio</option><option value="1">1</option><option value="2">2</option><option value="3">3+</option></select></label>
            <label><span>Sort</span><select id="f-sort"><option value="new">Newest</option><option value="asc">Price, low to high</option><option value="desc">Price, high to low</option></select></label>
            <div class="lf-foot">
              <button class="lf-reset" type="button" id="f-reset"><span class="roll">Reset</span></button>
              <button class="hs-apply lf-show" type="button" id="lf-show">Show <span id="lcount" aria-live="polite">{listings.length} properties</span></button>
            </div>
          </div>
        </div>
      </form>
      </div>
    </div>

    <a class="hx-down" href="#grid" aria-label="Scroll down"><span aria-hidden="true">&darr;</span></a>
  </section>

  <section class="sec light-2 list-sec" id="grid" aria-label="Listings">
    <div class="wrap">
      <div class="lgrid three" id="lgrid">
        {listings.map((l, i) => (
          <article class="lcard rv" data-slug={l.slug} data-type={typeAttr(l.type)} data-cat={l.offplan ? "offplan" : l.cat} data-area={l.area} data-beds={l.beds} data-price={l.price || 0} data-order={i}>
            <a class="lcard-link roll-host" href={`#${l.slug}`} data-open={l.slug}>
              <figure class:list={["media", l.gkey && "lgal"]} data-gallery={l.gkey || undefined}><img src={l.imgs[0]} alt={`${l.title}, ${areaName(l.area)}`} loading="lazy"><span class="ltag">{l.status}</span></figure>
              <p class="lmeta">{l.offplan ? "Off-plan" : l.cat === "rent" ? "Rent" : "Buy"} &mdash; {areaName(l.area)}</p>
              <h3 class="lname"><span class="roll">{l.title}</span></h3>
              <p class="lprice">{l.price == null ? (
                <span>Price on request</span>
              ) : (
                <Fragment><span class="price" data-aed={l.price}>AED {fmt(l.price)}</span>{l.cat === "rent" ? <Fragment> <small>/ yr</small></Fragment> : null}</Fragment>
              )}</p>
              <p class="lfacts">{l.beds === 0 && l.baths === 0 ? (
                <Fragment>{fmt(l.sqft)} sq ft</Fragment>
              ) : (
                <Fragment>{l.beds === 0 ? "Studio" : `${l.beds} bed`} &middot; {l.baths} bath &middot; {fmt(l.sqft)} sq ft</Fragment>
              )}</p>
            </a>
            <button class="save" type="button" data-save={l.slug} aria-pressed="false" aria-label={`Save ${l.title}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span>Save</span></button>
          </article>
        ))}
      </div>
      <div class="lempty" id="lempty" hidden>
        <p class="title sm">Nothing matches <em>just yet.</em></p>
        <p class="lede">Loosen a filter, or send us your brief: plenty of what we sell never gets listed.</p>
        <div class="actions"><button class="pill" type="button" id="f-reset2"><span class="roll">Reset filters</span><i class="pill-arrow" aria-hidden="true"></i></button></div>
      </div>
      <div class="lmap" id="lmap" hidden>
        <div class="lmap-stage" id="lmap-stage"></div>
        <p class="lmap-note">Schematic map of the Ras Al Khaimah coast, not to scale. Tap a pin to see the home.</p>
      </div>

      <div class="lfoot rv">
        <h2 class="title sm">Plenty of what we sell <em>never gets listed.</em></h2>
        <div class="actions" style="margin:0">
          <a class="btn solid" href="buy-sell-lease.html#buy"><span class="roll">Send your brief &#8599;</span></a>
          <a class="tlink" href="https://wa.me/971585015885?text=Hello%20RFR%2C%20here%20is%20what%20I%27m%20looking%20for%3A%20" target="_blank" rel="noopener"><span class="roll">Or WhatsApp us &#8599;</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec light" id="faq" aria-labelledby="faq-t">
    <div class="wrap faq-wrap">
      <div class="rv">
        <p class="kicker">( FAQ )</p>
        <h2 class="title" id="faq-t">Common <em>questions.</em></h2>
      </div>
      <div class="faq rv">
        <details><summary>What property is for sale in Ras Al Khaimah with RFR?<span class="pm" aria-hidden="true"></span></summary><p>Ready homes and off-plan units on Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK, updated as our book changes.</p></details>
        <details><summary>Can foreigners buy property in Ras Al Khaimah?<span class="pm" aria-hidden="true"></span></summary><p>Yes. Foreign buyers can own freehold property outright in Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.</p></details>
        <details><summary>Which areas of Ras Al Khaimah does RFR cover?<span class="pm" aria-hidden="true"></span></summary><p>Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK. We don&rsquo;t work outside Ras Al Khaimah.</p></details>
        <details><summary>How do off-plan payment plans work in Ras Al Khaimah?<span class="pm" aria-hidden="true"></span></summary><p>Buyers pay in instalments as the building is constructed, typically on a schedule between 50/50 and 80/20, with the balance due on or near handover.</p></details>
        <details><summary>Do I need to be in the UAE to buy property in Ras Al Khaimah?<span class="pm" aria-hidden="true"></span></summary><p>No. Many of our buyers live overseas. We run video viewings and can handle the paperwork and management once you own it.</p></details>
      </div>
    </div>
  </section>

  <section class="sec dark cta-band" id="contact" aria-labelledby="cta-t">
    <div class="wrap cta-in">
      <div class="rv">
        <p class="kicker">Have a property in mind?</p>
        <h2 class="title" id="cta-t">Send us <em>a message.</em></h2>
        <p class="lede">A line or two is plenty. An advisor will reply the same day with a clear next step.</p>
      </div>
      <div class="cta-side rv">
        <div class="cline"><span>Call</span><b>+971 58 501 5885</b></div>
        <div class="cline"><span>WhatsApp</span><a class="ulink" href="https://wa.me/971585015885?text=Hello%20RFR%2C%20I%20have%20a%20question%20about%20a%20property%20in%20Ras%20Al%20Khaimah." target="_blank" rel="noopener">Message directly &#8599;</a></div>
        <div class="cline"><span>Email</span><b>info@rfrrealestate.com</b></div>
        <div class="actions"><a class="pill on-dark" href="https://wa.me/971585015885?text=Hello%20RFR%2C%20I%20have%20a%20question%20about%20a%20property%20in%20Ras%20Al%20Khaimah." target="_blank" rel="noopener"><span class="roll">WhatsApp an advisor</span><i class="pill-arrow" aria-hidden="true"></i></a></div>
      </div>
    </div>
  </section>
</BaseLayout>
