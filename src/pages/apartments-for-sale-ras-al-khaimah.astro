---
// "Apartments for sale in Ras Al Khaimah" answer page, the sale twin of
// /apartments-for-rent-ras-al-khaimah. Copy lives in
// ../apartments-for-sale-ras-al-khaimah-main.html. The short answer, the
// prices-by-area table, the "for sale now" cards, the off-plan / ready text
// and the data-driven FAQ answers are rendered here from data.js at build
// time, so they stay in sync with /areas, /listings and /off-plan. The buying
// steps and fees are the ones published on /buy-sell-lease. Do not add DLD,
// RERA, mortgage, service-charge or legal facts that are not already on the
// site, and do not restate Golden Visa figures here (link the guide instead).
// The FAQ is rendered into the page AND into FAQPage JSON-LD from the same array.
import BaseLayout from "../layouts/BaseLayout.astro";
import rawHtml from "../apartments-for-sale-ras-al-khaimah-main.html?raw";
import { RFR as R } from "../data.js";

const SITE = "https://www.rfrrealestate.com";
const PATH = "/apartments-for-sale-ras-al-khaimah";
const PAGE = `${SITE}${PATH}`;
const TITLE = "Apartments for Sale in Ras Al Khaimah | RFR Real Estate";
const H1 = "Apartments for sale in Ras Al Khaimah";
const IMAGE = `${SITE}/media/rfr/apartment-living.jpg`;
const PUBLISHED = "2026-11-26";
const MODIFIED = "2026-11-27";

// Area guide pages.
const AREA_PAGES = { "al-marjan-island": "/al-marjan-island", "mina-al-arab": "/mina-al-arab", "al-hamra-village": "/al-hamra-village", "downtown-rak": "/downtown-ras-al-khaimah" };

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const aed = (n) => "AED " + Number(n).toLocaleString("en-US");
const aedShort = (n) => (n >= 1e6 ? `AED ${String(+(n / 1e6).toFixed(2))}M` : aed(n));
const areaBy = (slug) => R.areas.find((a) => a.slug === slug);
const listPhrase = (arr) => (arr.length < 2 ? arr.join("") : `${arr.slice(0, -1).join(", ")} and ${arr[arr.length - 1]}`);
const onIn = (a) => (/island/i.test(a.name) ? "on " : "in ") + a.name;
const SAVE_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>';

// Indicative "from" price of an apartment in each area, parsed from the
// areas[].buy strings in data.js ("Apartments from ~AED 400K", "From ~AED 920K (studio)").
function aptFrom(a) {
  const m = a.buy.match(/from ~AED ([\d.]+)K/i);
  if (!m) throw new Error(`apartments-for-sale: cannot read an apartment "from" price for ${a.slug} in data.js`);
  return { area: a, k: Number(m[1]), studio: /\(studio\)/i.test(a.buy.slice(m.index, m.index + m[0].length + 10)) };
}
const fromByArea = R.areas.map(aptFrom).sort((x, y) => x.k - y.k);
const fromPhrase = (f) => `AED ${f.k}K${f.studio ? " for a studio" : ""} ${onIn(f.area)}`;

// The short answer quotes the 1–2 bed branded range on Al Marjan Island. Fail
// the build if data.js changes, so the copy gets updated too.
const BRANDED = "AED 1.7–3.5M for 1–2 bed branded";
if (!areaBy("al-marjan-island")?.buy.includes(BRANDED)) throw new Error("apartments-for-sale: Al Marjan Island buy string in data.js changed; update the short answer and meta description");

// Apartments for sale: cat "buy", not a plot, with a price.
const sale = R.listings.filter((l) => l.cat === "buy" && !/plot/i.test(l.type) && l.price != null);
if (!sale.length) throw new Error("apartments-for-sale: no priced apartments for sale in data.js");
if (sale.some((l) => !areaBy(l.area))) throw new Error("apartments-for-sale: sale listing without a known area");
const prices = sale.map((l) => l.price);
const low = Math.min(...prices);
const high = Math.max(...prices);
const offplan = sale.filter((l) => l.offplan);
const ready = sale.filter((l) => !l.offplan);
const saleAreas = [...new Set(sale.map((l) => l.area))].map(areaBy);

// Off-plan payment plans, from data.js projects (as on /off-plan).
const planOf = (p) => String(p.plan).replace(/\s+/g, "");
const plans = [...new Set(R.projects.map(planOf))].sort((a, b) => parseInt(b, 10) - parseInt(a, 10));
const planRange = plans.length > 1 ? `from ${plans[plans.length - 1]} to ${plans[0]}` : plans[0];
const manta = R.projects.find((p) => p.slug === "manta");

const DESCRIPTION = `Apartments for sale in Ras Al Khaimah from ~AED ${fromByArea[0].k}K (${fromByArea[0].area.name}, indicative); our listings ${aedShort(low)}–${aedShort(high)}. Prices by area and how buying works.`;
if (DESCRIPTION.length > 160) throw new Error(`apartments-for-sale: meta description is ${DESCRIPTION.length} chars`);

// Short answer (40–70 words).
const shortAnswer = `Indicative apartment prices start from about ${listPhrase(fromByArea.map(fromPhrase))}, where 1&ndash;2 bed branded homes run AED 1.7&ndash;3.5M. The apartments we list for sale now cost <span class="price" data-aed="${low}">${aed(low)}</span> to <span class="price" data-aed="${high}">${aed(high)}</span>. We arrange viewings, in person or on video, and handle the checks, negotiation and paperwork.`;
const words = shortAnswer.replace(/<[^>]+>/g, "").split(/\s+/).filter(Boolean).length;
if (words < 40 || words > 70) throw new Error(`apartments-for-sale: short answer is ${words} words; keep it 40–70`);

// Prices by area table.
const priceRows = R.areas
  .map((a) => {
    const name = AREA_PAGES[a.slug] ? `<a href="${AREA_PAGES[a.slug]}">${esc(a.name)}</a>` : esc(a.name);
    return `              <tr><th scope="row">${name}</th><td>${esc(a.buy)}</td><td>${esc(a.yield)}</td></tr>`;
  })
  .join("\n");

// Listing cards: same markup as /listings, the area guides and the rent page.
function listingCard(l) {
  const area = areaBy(l.area);
  const price = `<span class="price" data-aed="${l.price}">${aed(l.price)}</span>`;
  const facts = [l.beds ? `${l.beds} bed` : "Studio", l.baths ? `${l.baths} bath` : null, l.sqft ? `${Number(l.sqft).toLocaleString("en-US")} sq ft` : null].filter(Boolean).join(" &middot; ");
  const extra = (l.offplan
    ? [l.developer, l.handover ? `handover ${l.handover}` : null, l.plan ? `${String(l.plan).replace(/\s+/g, "")} plan` : null]
    : ["Ready", l.type]
  ).filter(Boolean).map(esc).join(" &middot; ");
  const gal = l.gkey ? ` lgal" data-gallery="${esc(l.gkey)}` : "";
  return `        <article class="lcard rv" id="${esc(l.slug)}" data-slug="${esc(l.slug)}">
          <a class="lcard-link roll-host" href="listings.html#${esc(l.slug)}">
            <figure class="media${gal}"><img src="${esc(l.imgs[0])}" alt="${esc(l.title)}, ${esc(area.name)}" loading="lazy"><span class="ltag">${esc(l.status)}</span></figure>
            <p class="lmeta">${l.offplan ? "Off-plan" : "Ready"} &mdash; ${esc(area.name)}</p>
            <h3 class="lname"><span class="roll">${esc(l.title)}</span></h3>
            <p class="lprice">${price}</p>
            <p class="lfacts">${facts}</p>
            <p class="lfacts">${extra}</p>
          </a>
          <button class="save" type="button" data-save="${esc(l.slug)}" aria-pressed="false" aria-label="Save ${esc(l.title)}">${SAVE_SVG}<span>Save</span></button>
        </article>`;
}

const n = (k) => ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"][k] ?? String(k);
const saleLede = `The ${n(sale.length)} apartment${sale.length === 1 ? "" : "s"} we list for sale right now, ${onIn(saleAreas[0])}${saleAreas.length > 1 ? " and elsewhere" : ""}, from ${aed(low)} to ${aed(high)}. Our book changes, so ask us what else is coming up.`;

const handovers = [...new Set(offplan.map((l) => l.handover))].sort((a, b) => a.slice(-4) - b.slice(-4) || a.localeCompare(b));
const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1);
const offplanText = offplan.length
  ? `${ready.length ? `${cap(n(offplan.length))} of the ${n(sale.length)} apartments` : "Every apartment"} we list for sale right now ${offplan.length === 1 ? "is" : ready.length ? "are" : "is"} off-plan ${listPhrase([...new Set(offplan.map((l) => l.area))].map((s) => onIn(areaBy(s))))}, with handovers in ${listPhrase(handovers)}. You pay part of the price during construction and the rest on or after handover; plans on the launches we list run ${planRange}.${manta ? ` <a href="/manta-bay">Manta Bay Ras Al Khaimah</a>, for example, hands over in ${esc(manta.handover)} on a ${planOf(manta)} plan.` : ""}`
  : `We don&rsquo;t list an off-plan apartment for sale at the moment. Plans on the launches we list run ${planRange}.`;
const readyText = ready.length
  ? `${cap(n(ready.length))} ready apartment${ready.length === 1 ? " is" : "s are"} on our listings now. A ready home can be lived in or let straight away.`
  : `We don&rsquo;t have a ready apartment listed for sale at the moment; the ready homes we sell are on our <a href="/listings#cat-buy">listings of homes for sale in Ras Al Khaimah</a> as they come in.`;

const planRows = plans
  .map((pl) => {
    const [during, after] = pl.split("/");
    return `              <tr><td>${pl}</td><td>${during}%</td><td>${after}%</td></tr>`;
  })
  .join("\n");

// FAQ answers built from data.js where they quote it.
const plain = (s) => s.replace(/~/g, "about ").replace(/ · /g, "; ");
const buyByArea = R.areas.map((a) => `${a.name}: ${plain(a.buy)}`).join(". ");
const cheapest = fromByArea[0];
const second = fromByArea[1];
const yieldTop = (a) => Math.max(...(a.yield.match(/[\d.]+/g) || ["0"]).map(Number));
const yieldTxt = (a) => a.yield.replace(/\s*\(indicative\)/i, "");
const byYield = [...R.areas].sort((x, y) => yieldTop(y) - yieldTop(x));
const offplanPlans = listPhrase(offplan.map((l) => `${l.title.charAt(0).toLowerCase()}${l.title.slice(1)} (${esc(String(l.plan).replace(/\s+/g, ""))}, handover ${esc(l.handover)})`));
const areaLink = (a) => (AREA_PAGES[a.slug] ? `<a class="ulink" href="${AREA_PAGES[a.slug]}">${esc(a.name)}</a>` : esc(a.name));

// [question, answer HTML]. JSON-LD gets the same answer with tags stripped.
const faq = [
  ["How much is an apartment in Ras Al Khaimah?", `Indicative prices by area: ${esc(buyByArea)}. The apartments we list for sale right now range from ${aed(low)} to ${aed(high)}. Ranges are indicative, not a valuation; we send exact figures for any unit.`],
  ["Where is the cheapest place to buy an apartment in Ras Al Khaimah?", `On our indicative prices, ${areaLink(cheapest.area)}, where apartments start from about AED ${cheapest.k}K, followed by ${areaLink(second.area)} from about AED ${second.k}K. ${esc(cheapest.area.name)} is ${esc(cheapest.area.tag.replace(/\.$/, "").toLowerCase())}. These are starting points, not a valuation. Compare the areas on our <a class="ulink" href="/areas#best-areas">best areas in Ras Al Khaimah</a> guide.`],
  ["Can foreigners buy apartments in Ras Al Khaimah?", `Yes. Foreigners can buy freehold property in Ras Al Khaimah&rsquo;s designated freehold areas: Al Hamra Village, Mina Al Arab, Al Marjan Island, RAK Central, Julphar Towers, Al Maareedh (plots) and the upcoming Beach District. You own it outright, on a title deed. UAE and GCC nationals can buy anywhere in the Emirate. Full guide: <a class="ulink" href="/can-foreigners-buy-property-in-ras-al-khaimah">can foreigners buy property in Ras Al Khaimah?</a>`],
  ["Are there off-plan apartments with payment plans in Ras Al Khaimah?", `Yes. ${offplan.length ? `The off-plan apartments we list for sale right now are the ${offplanPlans}.` : ""} Plans on the launches we list run ${planRange}, meaning the first share is paid during construction and the rest on or after handover. See every launch on <a class="ulink" href="/off-plan">off-plan projects in Ras Al Khaimah</a>.`],
  ["Which area of Ras Al Khaimah has the highest rental yield?", `On our indicative figures, ${areaLink(byYield[0])} at ${esc(yieldTxt(byYield[0]))}, then ${areaLink(byYield[1])} at ${esc(yieldTxt(byYield[1]))}. ${listPhrase(byYield.slice(2).map((a) => `${areaLink(a)} is ${esc(yieldTxt(a))}`))}. Yields are indicative and gross, not a forecast.`],
  ["How do I arrange a viewing?", `Send us your budget and what the apartment is for, and an advisor replies the same day. Viewings are in person, or on video from abroad. Call +971 58 501 5885, email info@rfrrealestate.com or <a class="ulink" href="https://wa.me/971585015885?text=Hello%20RFR%2C%20I%27m%20looking%20for%20an%20apartment%20to%20buy%20in%20Ras%20Al%20Khaimah." target="_blank" rel="noopener">WhatsApp an advisor</a>.`],
];

const toText = (html) => html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").replace(/&rsquo;/g, "’").replace(/&ndash;/g, "–").replace(/&quot;/g, '"').replace(/\s+/g, " ").trim();
const faqHtml = faq
  .map(([q, a]) => `        <details><summary>${q}<span class="pm" aria-hidden="true"></span></summary><p>${a}</p></details>`)
  .join("\n");

const mainHtml = rawHtml
  .replace("<!--RFR:SHORT_ANSWER-->", shortAnswer)
  .replace("<!--RFR:PRICE_ROWS-->", priceRows)
  .replace("<!--RFR:SALE_LEDE-->", saleLede)
  .replace("<!--RFR:LISTING_CARDS-->", sale.map(listingCard).join("\n"))
  .replace("<!--RFR:OFFPLAN_TEXT-->", offplanText)
  .replace("<!--RFR:READY_TEXT-->", readyText)
  .replace("<!--RFR:PLAN_ROWS-->", planRows)
  .replace("<!--RFR:FAQ-->", faqHtml);
if (mainHtml.includes("<!--RFR:")) throw new Error("apartments-for-sale: placeholder not replaced");

const listItem = (i, name, url) => ({ "@type": "ListItem", position: i + 1, name, url });

const ldJson = [
  {"@context":"https://schema.org","@graph":[{"@type":["RealEstateAgent","LocalBusiness","Organization"],"@id":"https://www.rfrrealestate.com/#business","name":"RFR Real Estate & Advisory FZ-LLC","legalName":"RFR Real Estate & Advisory FZ-LLC","slogan":"Wherever you call home.","alternateName":["RFR","RFR Real Estate","RFR Real Estate & Advisory"],"url":"https://www.rfrrealestate.com/","logo":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","image":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","email":"info@rfrrealestate.com","telephone":"+971585015885","address":{"@type":"PostalAddress","addressLocality":"Ras Al Khaimah","addressRegion":"Ras Al Khaimah","addressCountry":"AE"},"areaServed":[{"@type":"AdministrativeArea","name":"Ras Al Khaimah"},{"@type":"Place","name":"Al Marjan Island"},{"@type":"Place","name":"Mina Al Arab"},{"@type":"Place","name":"Al Hamra Village"},{"@type":"Place","name":"Downtown Ras Al Khaimah"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"10:00","closes":"16:00"}],"priceRange":"AED 65,000/yr - AED 4,060,000","currenciesAccepted":"AED","knowsAbout":["Ras Al Khaimah real estate","Al Marjan Island","Off-plan property","Property management","UAE Golden Visa property investment"],"description":"RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.","disambiguatingDescription":"A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.","sameAs":["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]},{"@type":"WebSite","@id":"https://www.rfrrealestate.com/#website","name":"RFR Real Estate","alternateName":["RFR Real Estate & Advisory","RFR Real Estate & Advisory FZ-LLC","RFR","rfrrealestate.com"],"url":"https://www.rfrrealestate.com/","publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en"},
    {"@type":"BreadcrumbList","@id":`${PAGE}#breadcrumb`,"itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":`${SITE}/`},{"@type":"ListItem","position":2,"name":H1,"item":PAGE}]},
    {"@type":"WebPage","@id":`${PAGE}#webpage`,"url":PAGE,"name":H1,"description":DESCRIPTION,"isPartOf":{"@id":`${SITE}/#website`},"publisher":{"@id":`${SITE}/#business`},"inLanguage":"en","datePublished":PUBLISHED,"dateModified":MODIFIED,"primaryImageOfPage":{"@type":"ImageObject","url":IMAGE},"breadcrumb":{"@id":`${PAGE}#breadcrumb`},"mainEntity":{"@id":`${PAGE}#listings`}}]},
  {"@context":"https://schema.org","@type":"FAQPage","@id":`${PAGE}#faq`,"mainEntity":faq.map(([q, a]) => ({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":toText(a)}}))},
  {"@context":"https://schema.org","@type":"ItemList","@id":`${PAGE}#listings`,"name":"Apartments for sale in Ras Al Khaimah listed by RFR","url":`${PAGE}#for-sale-now`,"numberOfItems":sale.length,"itemListElement":sale.map((l, i) => listItem(i, `${l.title}, ${areaBy(l.area).name}`, `${SITE}/listings#${l.slug}`))},
];
---
<BaseLayout page="apartments-for-sale-ras-al-khaimah" title={TITLE} description={DESCRIPTION} path={PATH} ldJson={ldJson}>
<Fragment set:html={mainHtml} />
<script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
