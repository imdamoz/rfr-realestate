---
// Al Marjan Island area guide. Copy lives in ../al-marjan-island-main.html;
// the listing cards (same markup as /listings) and off-plan launch cards
// (same markup as /off-plan) are rendered here from data.js at build time,
// so they can't drift from the rest of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import rawHtml from "../al-marjan-island-main.html?raw";
import { RFR as R } from "../data.js";

const SITE = "https://www.rfrrealestate.com";
const PAGE = `${SITE}/al-marjan-island`;
const AREA = "al-marjan-island";
const area = R.areas.find((a) => a.slug === AREA);

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const aed = (n) => "AED " + Number(n).toLocaleString("en-US");
const wa = (t) => "https://wa.me/971585015885?text=" + encodeURIComponent(t);
const SAVE_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>';

const listings = R.listings.filter((l) => l.area === AREA);
const projects = R.projects; // every launch in data.js is on Al Marjan Island (see /off-plan)

function listingCard(l) {
  const cat = l.offplan ? "Off-plan" : l.cat === "rent" ? "Rent" : "Buy";
  const price = l.price == null
    ? "<span>Price on request</span>"
    : `<span class="price" data-aed="${l.price}">${aed(l.price)}</span>${l.cat === "rent" ? " <small>/ yr</small>" : ""}`;
  const facts = [l.beds ? `${l.beds} bed` : "Studio", l.baths ? `${l.baths} bath` : null, l.sqft ? `${Number(l.sqft).toLocaleString("en-US")} sq ft` : null].filter(Boolean).join(" &middot; ");
  const gal = l.gkey ? ` lgal" data-gallery="${esc(l.gkey)}` : "";
  return `        <article class="lcard rv" id="${esc(l.slug)}" data-slug="${esc(l.slug)}">
          <a class="lcard-link roll-host" href="listings.html#${esc(l.slug)}">
            <figure class="media${gal}"><img src="${esc(l.imgs[0])}" alt="${esc(l.title)}, ${esc(area.name)}" loading="lazy"><span class="ltag">${esc(l.status)}</span></figure>
            <p class="lmeta">${cat} &mdash; ${esc(area.name)}</p>
            <h3 class="lname"><span class="roll">${esc(l.title)}</span></h3>
            <p class="lprice">${price}</p>
            <p class="lfacts">${facts}</p>
          </a>
          <button class="save" type="button" data-save="${esc(l.slug)}" aria-pressed="false" aria-label="Save ${esc(l.title)}">${SAVE_SVG}<span>Save</span></button>
        </article>`;
}

function launchCard(p, i) {
  const [a, b] = String(p.plan).split("/").map((s) => parseInt(s, 10));
  const name = p.slug === "manta" ? `<a href="/manta-bay">${esc(p.name)}</a>` : esc(p.name);
  return `        <article class="pcard rv" id="launch-${esc(p.slug)}">
          <figure class="media zoom"><img src="media/projects/${esc(p.slug)}.jpg" alt="${esc(p.alt)}" loading="lazy"><span class="ltag">Handover ${esc(p.handover)}</span></figure>
          <div class="pcard-body">
            <div class="pcard-top"><span class="op-n">${String(i + 1).padStart(2, "0")}</span></div>
            <h3>${name}</h3>
            <p class="op-dev">${esc(p.dev)} &middot; ${esc(area.name)}</p>
            <p class="pnote">${esc(p.note)}</p>
            <dl>
              <dt>From</dt><dd><span class="price op-price" data-aed="${p.from}">${esc(p.fromTxt)}</span></dd>
              <dt>Plan</dt><dd class="op-plan">${esc(p.plan)} <span class="op-bar" aria-hidden="true"><i style="width:${a}%"></i><i style="width:${b}%"></i></span></dd>
              <dt>Unit mix</dt><dd>${esc(p.mix)}</dd>
            </dl>
            <div class="pcard-foot">
              <a class="tlink" href="/off-plan#${esc(p.slug)}"><span class="roll">Compare</span></a>
              <a class="tlink" href="${wa(`Hello RFR, what is still available at ${p.name}?`)}" target="_blank" rel="noopener"><span class="roll">Availability &#8599;</span></a>
            </div>
          </div>
        </article>`;
}

const mainHtml = rawHtml
  .replace("<!--RFR:LISTING_CARDS-->", listings.map(listingCard).join("\n"))
  .replace("<!--RFR:LAUNCH_CARDS-->", projects.map(launchCard).join("\n"));
if (mainHtml.includes("<!--RFR:")) throw new Error("al-marjan-island: card placeholder not replaced");

const listItem = (i, name, url) => ({ "@type": "ListItem", position: i + 1, name, url });

const ldJson = [
  {"@context":"https://schema.org","@graph":[{"@type":["RealEstateAgent","LocalBusiness"],"@id":"https://www.rfrrealestate.com/#business","name":"RFR Real Estate & Advisory FZ-LLC","alternateName":["RFR","RFR Real Estate","RFR Real Estate & Advisory"],"url":"https://www.rfrrealestate.com/","logo":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","image":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","email":"info@rfrrealestate.com","telephone":"+971585015885","address":{"@type":"PostalAddress","addressLocality":"Ras Al Khaimah","addressRegion":"Ras Al Khaimah","addressCountry":"AE"},"areaServed":[{"@type":"AdministrativeArea","name":"Ras Al Khaimah"},{"@type":"Place","name":"Al Marjan Island"},{"@type":"Place","name":"Mina Al Arab"},{"@type":"Place","name":"Al Hamra Village"},{"@type":"Place","name":"Downtown Ras Al Khaimah"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"10:00","closes":"16:00"}],"priceRange":"AED 65,000/yr - AED 4,060,000","currenciesAccepted":"AED","knowsAbout":["Ras Al Khaimah real estate","Al Marjan Island","Off-plan property","Property management","UAE Golden Visa property investment"],"description":"RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.","disambiguatingDescription":"A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.","sameAs":["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]},{"@type":"WebSite","@id":"https://www.rfrrealestate.com/#website","name":"RFR Real Estate","url":"https://www.rfrrealestate.com/","publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en"},
    {"@type":"BreadcrumbList","@id":`${PAGE}#breadcrumb`,"itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":`${SITE}/`},{"@type":"ListItem","position":2,"name":"Areas","item":`${SITE}/areas`},{"@type":"ListItem","position":3,"name":"Al Marjan Island","item":PAGE}]},
    {"@type":"Place","@id":`${PAGE}#place`,"name":"Al Marjan Island","url":PAGE,"description":"A group of four man-made, coral-shaped islands off the Al Hamra coast in Ras Al Khaimah, where most of the Emirate’s branded residences are being built and where the Wynn resort is due to open in 2027.","geo":{"@type":"GeoCoordinates","latitude":area.lat,"longitude":area.lng},"image":`${SITE}/${area.img}`,"containedInPlace":{"@type":"AdministrativeArea","name":"Ras Al Khaimah","containedInPlace":{"@type":"Country","name":"United Arab Emirates"}}},
    {"@type":"WebPage","@id":`${PAGE}#webpage`,"url":PAGE,"name":"Al Marjan Island, Ras Al Khaimah: apartments, prices and what’s nearby","isPartOf":{"@id":`${SITE}/#website`},"publisher":{"@id":`${SITE}/#business`},"inLanguage":"en","datePublished":"2026-11-22","dateModified":"2026-11-22","primaryImageOfPage":{"@type":"ImageObject","url":`${SITE}/media/rfr/marjan-aerial.jpg`},"about":{"@id":`${PAGE}#place`},"breadcrumb":{"@id":`${PAGE}#breadcrumb`}}]},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"Where is Al Marjan Island?","acceptedAnswer":{"@type":"Answer","text":"In Ras Al Khaimah, UAE: a group of four man-made, coral-shaped islands off the Al Hamra coast. It is about 35 minutes from RAK Airport and 55 minutes from Dubai airport (DXB)."}},
    {"@type":"Question","name":"Can foreigners buy property on Al Marjan Island?","acceptedAnswer":{"@type":"Answer","text":"Yes. Al Marjan Island is a designated freehold area, so foreign buyers can own property there outright, including off-plan units."}},
    {"@type":"Question","name":"How much does an apartment on Al Marjan Island cost?","acceptedAnswer":{"@type":"Answer","text":"Studios start from about AED 920K, and one- and two-bedroom branded homes run about AED 1.7–3.5M. The off-plan launches in our book start from AED 920,000 to AED 4.06M. Ranges are indicative, not a valuation; we send exact figures for any unit."}},
    {"@type":"Question","name":"What do apartments on Al Marjan Island rent for?","acceptedAnswer":{"@type":"Answer","text":"One-bedrooms rent for about AED 65–90K a year and two-bedrooms for about AED 75–130K a year. Indicative gross yields are 6–8%."}},
    {"@type":"Question","name":"When does Wynn Al Marjan Island open?","acceptedAnswer":{"@type":"Answer","text":"Wynn Al Marjan Island is scheduled to open in 2027. Almost every current launch on the island is priced against that date."}},
    {"@type":"Question","name":"Is RFR a real estate agency on Al Marjan Island?","acceptedAnswer":{"@type":"Answer","text":"RFR Real Estate & Advisory works only in Ras Al Khaimah, and Al Marjan Island is one of the four areas we cover, with Mina Al Arab, Al Hamra Village and Downtown RAK. We list homes to buy and rent on the island and its off-plan launches."}}]},
  {"@context":"https://schema.org","@type":"ItemList","@id":`${PAGE}#listings`,"name":"Homes listed by RFR on Al Marjan Island","url":`${PAGE}#listings`,"numberOfItems":listings.length,"itemListElement":listings.map((l, i) => listItem(i, `${l.title}, ${area.name}`, `${SITE}/listings#${l.slug}`))},
  {"@context":"https://schema.org","@type":"ItemList","@id":`${PAGE}#off-plan-launches`,"name":"Off-plan launches on Al Marjan Island, Ras Al Khaimah","url":`${PAGE}#off-plan-launches`,"numberOfItems":projects.length,"itemListElement":projects.map((p, i) => listItem(i, p.name, `${SITE}/off-plan#${p.slug}`))},
];
---
<BaseLayout page="al-marjan-island" title={"Al Marjan Island Apartments for Sale & Rent | RFR Real Estate"} description={"Al Marjan Island, Ras Al Khaimah: apartments for sale and rent, indicative prices, rents and yields, the off-plan launches near the Wynn resort, and an FAQ."} path="/al-marjan-island" ldJson={ldJson}>
<Fragment set:html={mainHtml} />
<script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
