---
import BaseLayout from "../layouts/BaseLayout.astro";
import rawHtml from "../off-plan-main.html?raw";
import { offPlanItemList, faqFromHtml } from "../seo-jsonld.js";
import { RFR as R } from "../data.js";

// "Off-plan projects in Ras Al Khaimah" list, summary and payment-plan table
// are rendered from data.js (R.projects, the same data as the cards below
// them), so the list can't drift from the cards. Every launch in the book is
// on Al Marjan Island (as the page and the FAQ already say).
const SITE = "https://www.rfrrealestate.com";
const AREA = "Al Marjan Island";
const P = R.projects;
if (P.length !== 9) throw new Error(`off-plan: expected 9 projects in data.js, got ${P.length}`);
const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const plan = (p) => p.plan.replace(/\s*\/\s*/, "/");
const projectLink = (p) => (p.slug === "manta" ? `<a href="/manta-bay">${esc(p.name)}</a>` : `<a href="#${esc(p.slug)}">${esc(p.name)}</a>`);
const priceSpan = (p) => `<span class="price" data-aed="${p.from}">${esc(p.fromTxt)}</span>`;
const cheapest = P.reduce((a, b) => (b.from < a.from ? b : a));
const dearest = P.reduce((a, b) => (b.from > a.from ? b : a));
const listNames = (arr) => arr.length < 2 ? arr.join("") : `${arr.slice(0, -1).join(", ")} and ${arr[arr.length - 1]}`;

const summary = `RFR currently lists nine off-plan projects in Ras Al Khaimah, all on <a href="/al-marjan-island">${AREA}</a>: ${listNames(P.map(projectLink))}. Starting prices run from ${priceSpan(cheapest)} (${esc(cheapest.name)}) to ${priceSpan(dearest)} (${esc(dearest.name)}), payment plans from 50/50 to 80/20, and handovers from Q4 2026 to Q4 2028.`;

const rows = P.map((p) => `              <tr><td>${projectLink(p)}</td><td>${AREA}</td><td>${esc(p.dev)}</td><td>${esc(p.mix)}</td><td>${esc(p.handover)}</td><td>${plan(p)}</td><td>${priceSpan(p)}</td></tr>`).join("\n");

const plans = [...new Set(P.map(plan))].sort((a, b) => Number(b.split("/")[0]) - Number(a.split("/")[0]));
const planRows = plans.map((pl) => {
  const [during, after] = pl.split("/");
  const names = P.filter((p) => plan(p) === pl).map(projectLink);
  return `              <tr><td>${pl}</td><td>${during}%</td><td>${after}%</td><td>${listNames(names)}</td></tr>`;
}).join("\n");
if (plans[0] !== "80/20" || plans[plans.length - 1] !== "50/50") throw new Error("off-plan: payment plan range no longer 50/50 to 80/20; update the copy");

// Payment-plan FAQs, from the same data as the payment-plan table.
const faqItem = (q, a) => `        <details><summary>${q}<span class="pm" aria-hidden="true"></span></summary><p>${a}</p></details>`;
const onPlan = (pl) => P.filter((p) => plan(p) === pl);
const names = (arr) => listNames(arr.map((p) => (p.slug === "manta" ? `<a class="ulink" href="/manta-bay">${esc(p.name)}</a>` : esc(p.name))));
const lowest = plans[plans.length - 1];
const [lowDuring, lowAfter] = lowest.split("/");
const others = plans.filter((pl) => pl !== "60/40").map((pl) => `${names(onPlan(pl))} ${onPlan(pl).length > 1 ? "are" : "is"} on ${pl}`);
if (!onPlan("60/40").length) throw new Error("off-plan: no 60/40 plans left; update the payment-plan FAQs");
const planFaqs = [
  faqItem("Which off-plan projects in Ras Al Khaimah ask for the least before handover?", `${names(onPlan(lowest))} ${onPlan(lowest).length > 1 ? "are" : "is"} on a ${lowest} payment plan: ${lowDuring}% is paid during construction and ${lowAfter}% on or after handover, the smallest share before handover of the nine launches we list.`),
  faqItem("Which off-plan projects in Ras Al Khaimah have a 60/40 payment plan?", `${names(onPlan("60/40"))}: 60% is paid during construction and 40% on or after handover. ${listNames(others)}.`),
].join("\n");

const mainHtml = rawHtml
  .replace("<!--RFR:PLAN_FAQS-->", planFaqs)
  .replace("<!--RFR:OFFPLAN_SUMMARY-->", summary)
  .replace("<!--RFR:OFFPLAN_ROWS-->", rows)
  .replace("<!--RFR:PLAN_ROWS-->", planRows);
if (mainHtml.includes("<!--RFR:")) throw new Error("off-plan: placeholder not replaced");

const projectsList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${SITE}/off-plan#off-plan-projects-list`,
  "name": "Off-plan projects in Ras Al Khaimah",
  "description": "Off-plan projects RFR lists in Ras Al Khaimah, all on Al Marjan Island, with developer, unit mix, handover, payment plan and starting price.",
  "url": `${SITE}/off-plan#off-plan-projects-list`,
  "itemListOrder": "https://schema.org/ItemListUnordered",
  "numberOfItems": P.length,
  "itemListElement": P.map((p, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${p.name}, ${AREA}`, "url": `${SITE}/off-plan#${p.slug}` })),
};
const ldJson = [
  {"@context":"https://schema.org","@graph":[{"@type":["RealEstateAgent","LocalBusiness","Organization"],"@id":"https://www.rfrrealestate.com/#business","name":"RFR Real Estate & Advisory FZ-LLC","legalName":"RFR Real Estate & Advisory FZ-LLC","slogan":"Wherever you call home.","alternateName":["RFR","RFR Real Estate","RFR Real Estate & Advisory"],"url":"https://www.rfrrealestate.com/","logo":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","image":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","email":"info@rfrrealestate.com","telephone":"+971585015885","address":{"@type":"PostalAddress","addressLocality":"Ras Al Khaimah","addressRegion":"Ras Al Khaimah","addressCountry":"AE"},"areaServed":[{"@type":"AdministrativeArea","name":"Ras Al Khaimah"},{"@type":"Place","name":"Al Marjan Island"},{"@type":"Place","name":"Mina Al Arab"},{"@type":"Place","name":"Al Hamra Village"},{"@type":"Place","name":"Downtown Ras Al Khaimah"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"10:00","closes":"16:00"}],"priceRange":"AED 65,000/yr - AED 4,060,000","currenciesAccepted":"AED","knowsAbout":["Ras Al Khaimah real estate","Al Marjan Island","Off-plan property","Property management","UAE Golden Visa property investment"],"description":"RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.","disambiguatingDescription":"A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.","sameAs":["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]},{"@type":"WebSite","@id":"https://www.rfrrealestate.com/#website","name":"RFR Real Estate","alternateName":["RFR Real Estate & Advisory","RFR Real Estate & Advisory FZ-LLC","RFR","rfrrealestate.com"],"url":"https://www.rfrrealestate.com/","publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.rfrrealestate.com/"},{"@type":"ListItem","position":2,"name":"Off-Plan","item":"https://www.rfrrealestate.com/off-plan"}]},{"@type":"WebPage","@id":"https://www.rfrrealestate.com/off-plan#webpage","url":"https://www.rfrrealestate.com/off-plan","name":"Off-plan projects in Ras Al Khaimah","description":"Nine off-plan projects on Al Marjan Island, Ras Al Khaimah, with developer, unit mix, handover, payment plan and starting price.","isPartOf":{"@id":"https://www.rfrrealestate.com/#website"},"publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en","dateModified":"2026-11-26","mainEntity":{"@id":"https://www.rfrrealestate.com/off-plan#off-plan-projects-list"}}]},
  faqFromHtml(mainHtml),
  offPlanItemList(mainHtml),
  projectsList,
];
---
<BaseLayout page="off-plan" title={"Off-Plan Projects in Ras Al Khaimah | RFR Real Estate"} description={"Nine off-plan projects on Al Marjan Island, Ras Al Khaimah, compared: Emaar, Aldar, Ellington and more, from AED 920,000, with payment plans and handovers."} path="/off-plan" ldJson={ldJson}>
<Fragment set:html={mainHtml} />
<script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
