---
import BaseLayout from "../layouts/BaseLayout.astro";
import rawHtml from "../off-plan-main.html?raw";
import { offPlanItemList } from "../seo-jsonld.js";
import { RFR as R } from "../data.js";

// "Off-plan projects in Ras Al Khaimah" list, summary and payment-plan table
// are rendered from data.js (R.projects, the same data as the cards below
// them), so the list can't drift from the cards. Every launch in the book is
// on Al Marjan Island (as the page and the FAQ already say).
const SITE = "https://www.rfrrealestate.com";
const AREA = "Al Marjan Island";
const P = R.projects;
if (P.length !== 9) throw new Error(`off-plan: expected 9 projects in data.js, got ${P.length}`);
const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const plan = (p) => p.plan.replace(/\s*\/\s*/, "/");
const projectLink = (p) => (p.slug === "manta" ? `<a href="/manta-bay">${esc(p.name)}</a>` : `<a href="#${esc(p.slug)}">${esc(p.name)}</a>`);
const priceSpan = (p) => `<span class="price" data-aed="${p.from}">${esc(p.fromTxt)}</span>`;
const cheapest = P.reduce((a, b) => (b.from < a.from ? b : a));
const dearest = P.reduce((a, b) => (b.from > a.from ? b : a));
const listNames = (arr) => arr.length < 2 ? arr.join("") : `${arr.slice(0, -1).join(", ")} and ${arr[arr.length - 1]}`;

const summary = `RFR currently lists nine off-plan projects in Ras Al Khaimah, all on <a href="/al-marjan-island">${AREA}</a>: ${listNames(P.map(projectLink))}. Starting prices run from ${priceSpan(cheapest)} (${esc(cheapest.name)}) to ${priceSpan(dearest)} (${esc(dearest.name)}), payment plans from 50/50 to 80/20, and handovers from Q4 2026 to Q4 2028.`;

const rows = P.map((p) => `              <tr><td>${projectLink(p)}</td><td>${AREA}</td><td>${esc(p.dev)}</td><td>${esc(p.mix)}</td><td>${esc(p.handover)}</td><td>${plan(p)}</td><td>${priceSpan(p)}</td></tr>`).join("\n");

const plans = [...new Set(P.map(plan))].sort((a, b) => Number(b.split("/")[0]) - Number(a.split("/")[0]));
const planRows = plans.map((pl) => {
  const [during, after] = pl.split("/");
  const names = P.filter((p) => plan(p) === pl).map(projectLink);
  return `              <tr><td>${pl}</td><td>${during}%</td><td>${after}%</td><td>${listNames(names)}</td></tr>`;
}).join("\n");
if (plans[0] !== "80/20" || plans[plans.length - 1] !== "50/50") throw new Error("off-plan: payment plan range no longer 50/50 to 80/20; update the copy");

const mainHtml = rawHtml
  .replace("<!--RFR:OFFPLAN_SUMMARY-->", summary)
  .replace("<!--RFR:OFFPLAN_ROWS-->", rows)
  .replace("<!--RFR:PLAN_ROWS-->", planRows);
if (mainHtml.includes("<!--RFR:")) throw new Error("off-plan: placeholder not replaced");

const projectsList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${SITE}/off-plan#off-plan-projects-list`,
  "name": "Off-plan projects in Ras Al Khaimah",
  "description": "Off-plan projects RFR lists in Ras Al Khaimah, all on Al Marjan Island, with developer, unit mix, handover, payment plan and starting price.",
  "url": `${SITE}/off-plan#off-plan-projects-list`,
  "itemListOrder": "https://schema.org/ItemListUnordered",
  "numberOfItems": P.length,
  "itemListElement": P.map((p, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${p.name}, ${AREA}`, "url": `${SITE}/off-plan#${p.slug}` })),
};
const ldJson = [
  {"@context":"https://schema.org","@graph":[{"@type":["RealEstateAgent","LocalBusiness","Organization"],"@id":"https://www.rfrrealestate.com/#business","name":"RFR Real Estate & Advisory FZ-LLC","legalName":"RFR Real Estate & Advisory FZ-LLC","slogan":"Wherever you call home.","alternateName":["RFR","RFR Real Estate","RFR Real Estate & Advisory"],"url":"https://www.rfrrealestate.com/","logo":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","image":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","email":"info@rfrrealestate.com","telephone":"+971585015885","address":{"@type":"PostalAddress","addressLocality":"Ras Al Khaimah","addressRegion":"Ras Al Khaimah","addressCountry":"AE"},"areaServed":[{"@type":"AdministrativeArea","name":"Ras Al Khaimah"},{"@type":"Place","name":"Al Marjan Island"},{"@type":"Place","name":"Mina Al Arab"},{"@type":"Place","name":"Al Hamra Village"},{"@type":"Place","name":"Downtown Ras Al Khaimah"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"10:00","closes":"16:00"}],"priceRange":"AED 65,000/yr - AED 4,060,000","currenciesAccepted":"AED","knowsAbout":["Ras Al Khaimah real estate","Al Marjan Island","Off-plan property","Property management","UAE Golden Visa property investment"],"description":"RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.","disambiguatingDescription":"A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.","sameAs":["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]},{"@type":"WebSite","@id":"https://www.rfrrealestate.com/#website","name":"RFR Real Estate","alternateName":["RFR Real Estate & Advisory","RFR Real Estate & Advisory FZ-LLC","RFR","rfrrealestate.com"],"url":"https://www.rfrrealestate.com/","publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.rfrrealestate.com/"},{"@type":"ListItem","position":2,"name":"Off-Plan","item":"https://www.rfrrealestate.com/off-plan"}]}]},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What does off-plan mean?","acceptedAnswer":{"@type":"Answer","text":"Off-plan means signing for a home before it's finished. You decide from renders, floor plans and a site visit, and pay in instalments as it's built."}},{"@type":"Question","name":"What off-plan projects are there in Ras Al Khaimah?","acceptedAnswer":{"@type":"Answer","text":"Nine current launches, all on Al Marjan Island, from developers including Emaar, Aldar, Ellington and Marriott, with starting prices from AED 920,000 to AED 4.06M."}},{"@type":"Question","name":"Can foreigners buy off-plan on Al Marjan Island?","acceptedAnswer":{"@type":"Answer","text":"Yes. Al Marjan Island is freehold, so foreign buyers can own off-plan units outright, the same as ready homes."}},{"@type":"Question","name":"What payment plans do off-plan projects in Ras Al Khaimah offer?","acceptedAnswer":{"@type":"Answer","text":"Current launches run from 50/50 to 80/20, meaning 50% to 80% is paid during construction and the rest on or after handover."}},{"@type":"Question","name":"When do the off-plan launches hand over?","acceptedAnswer":{"@type":"Answer","text":"Handovers in our current book range from Q4 2026 (Manta Bay, Sora Beach Residences, Masa Residence) to 2028 (Address Residences, Nikki Beach Residences, Costa Mare)."}},{"@type":"Question","name":"Do starting prices change with the floor, view and payment plan?","acceptedAnswer":{"@type":"Answer","text":"Yes. Starting prices are the lowest entry point; floor, view and the payment plan chosen all move the final figure. We send exact unit-level pricing on request."}}]},
  offPlanItemList(mainHtml),
  projectsList,
];
---
<BaseLayout page="off-plan" title={"Off-Plan Projects in Ras Al Khaimah | RFR Real Estate"} description={"Nine off-plan projects on Al Marjan Island, Ras Al Khaimah, compared: Emaar, Aldar, Ellington and more, from AED 920,000, with payment plans and handovers."} path="/off-plan" ldJson={ldJson}>
<Fragment set:html={mainHtml} />
<script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
