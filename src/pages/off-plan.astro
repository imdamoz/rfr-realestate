---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RFR } from "../data.js";

const ldJson = [
  {"@context": "https://schema.org", "@graph": [{"@type": ["RealEstateAgent", "LocalBusiness"], "@id": "https://www.rfrrealestate.com/#business", "name": "RFR Real Estate & Advisory FZ-LLC", "alternateName": ["RFR", "RFR Real Estate", "RFR Real Estate & Advisory"], "url": "https://www.rfrrealestate.com/", "logo": "https://www.rfrrealestate.com/media/rfr-logo-gold.webp", "image": "https://www.rfrrealestate.com/media/rfr-logo-gold.webp", "email": "info@rfrrealestate.com", "telephone": "+971585015885", "address": {"@type": "PostalAddress", "addressLocality": "Ras Al Khaimah", "addressRegion": "Ras Al Khaimah", "addressCountry": "AE"}, "areaServed": [{"@type": "AdministrativeArea", "name": "Ras Al Khaimah"}, {"@type": "Place", "name": "Al Marjan Island"}, {"@type": "Place", "name": "Mina Al Arab"}, {"@type": "Place", "name": "Al Hamra Village"}, {"@type": "Place", "name": "Downtown Ras Al Khaimah"}], "openingHoursSpecification": [{"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "09:00", "closes": "18:00"}, {"@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "16:00"}], "priceRange": "AED 65,000/yr - AED 4,060,000", "currenciesAccepted": "AED", "knowsAbout": ["Ras Al Khaimah real estate", "Al Marjan Island", "Off-plan property", "Property management", "UAE Golden Visa property investment"], "description": "RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.", "disambiguatingDescription": "A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.", "sameAs": ["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]}, {"@type": "WebSite", "@id": "https://www.rfrrealestate.com/#website", "name": "RFR Real Estate", "url": "https://www.rfrrealestate.com/", "publisher": {"@id": "https://www.rfrrealestate.com/#business"}, "inLanguage": "en"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.rfrrealestate.com/"}, {"@type": "ListItem", "position": 2, "name": "Off-Plan", "item": "https://www.rfrrealestate.com/off-plan"}]}]},
  {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What does off-plan mean?", "acceptedAnswer": {"@type": "Answer", "text": "Off-plan means signing for a home before it's finished. You decide from renders, floor plans and a site visit, and pay in instalments as it's built."}}, {"@type": "Question", "name": "What off-plan projects are there in Ras Al Khaimah?", "acceptedAnswer": {"@type": "Answer", "text": "Nine current launches, all on Al Marjan Island, from developers including Emaar, Aldar, Ellington and Marriott, with starting prices from AED 920,000 to AED 4.06M."}}, {"@type": "Question", "name": "Can foreigners buy off-plan on Al Marjan Island?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Al Marjan Island is freehold, so foreign buyers can own off-plan units outright, the same as ready homes."}}, {"@type": "Question", "name": "What payment plans do off-plan projects in Ras Al Khaimah offer?", "acceptedAnswer": {"@type": "Answer", "text": "Current launches run from 50/50 to 80/20, meaning 50% to 80% is paid during construction and the rest on or after handover."}}, {"@type": "Question", "name": "When do the off-plan launches hand over?", "acceptedAnswer": {"@type": "Answer", "text": "Handovers in our current book range from Q4 2026 (Manta Bay, Sora Beach Residences, Masa Residence) to 2028 (Address Residences, Nikki Beach Residences, Costa Mare)."}}, {"@type": "Question", "name": "Do starting prices change with the floor, view and payment plan?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Starting prices are the lowest entry point; floor, view and the payment plan chosen all move the final figure. We send exact unit-level pricing on request."}}]}
];

const waText = (text) => `https://wa.me/971585015885?text=${encodeURIComponent(text)}`;
---
<BaseLayout page="off-plan" title="Off-Plan | RFR Real Estate" description="Nine off-plan launches on Al Marjan Island, compared." path="/off-plan" ldJson={ldJson}>
  <section class="phx hx" aria-labelledby="op-t">
    <div class="phx-bg" aria-hidden="true"><img class="is-on" src="media/rak/rak-marjan-aerial.jpg" alt="" fetchpriority="high"></div>
    <div class="wrap hx-in">
      <h1 class="giant sand hx-t" id="op-t" data-split>Before the launch</h1>
      <div class="hx-block">
        <p class="hx-label">Off-plan &middot; Al Marjan Island</p>
        <p class="hx-text">Get in before launch day. Nine branded launches on the island, and we&rsquo;ll tell you which are worth it, and which to skip.</p>
        <a class="pill solid" href="#projects"><span class="roll">See the nine launches</span><i class="pill-arrow" aria-hidden="true"></i></a>
      </div>
    </div>

    <a class="hx-down" href="#what" aria-label="Scroll down"><span aria-hidden="true">&darr;</span></a>
  </section>

  <section class="sec light op-what" id="what" aria-labelledby="opw-t">
    <div class="wrap op-explain light-explain">
      <div class="rv">
        <p class="kicker">What &ldquo;off-plan&rdquo; means</p>
        <h2 class="title sm" id="opw-t">You&rsquo;re buying something <em>that isn&rsquo;t built yet.</em></h2>
        <p class="body-t">Off-plan means signing for a home before it&rsquo;s finished. Building work may have started, but you can&rsquo;t walk through your unit, so you decide from renders, floor plans, virtual tours and a visit to the site.</p>
        <p class="body-t">That&rsquo;s why it helps to have someone check the developer&rsquo;s track record, the payment plan and the exact plot before you sign.</p>
      </div>
      <ol class="op-points rv">
        <li><span class="n">/ 01</span><b>Lower prices at launch</b><p>Launch prices usually undercut finished homes, and early units cost least.</p></li>
        <li><span class="n">/ 02</span><b>Near the new resorts</b><p>Most launches are on the waterfront, by the resorts.</p></li>
        <li><span class="n">/ 03</span><b>Pay in stages</b><p>You pay in instalments as it&rsquo;s built.</p></li>
      </ol>
    </div>
  </section>

  <section class="sec dark op-launches" id="projects" aria-labelledby="opl-t">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <p class="kicker">( 02 ) Current launches</p>
          <h2 class="title" id="opl-t">Nine launches on <em>Al Marjan Island.</em></h2>
          <p class="op-hint">Tick up to 3 to compare</p>
        </div>
        <p class="lede">These are starting prices. The floor, view and payment plan change the final figure, so compare a few and ask us what&rsquo;s left.</p>
      </div>
      <div class="op-grid">
        {RFR.projects.map((p, i) => {
          const [a, b] = p.plan.split(" / ").map(Number);
          return (
            <article class="pcard rv" id={p.slug} data-p={p.slug}>
              <figure class="media zoom"><img src={`media/projects/${p.slug}.jpg`} alt={p.alt} loading="lazy"><span class="ltag">Handover {p.handover}</span></figure>
              <div class="pcard-body">
                <div class="pcard-top"><span class="op-n">{String(i + 1).padStart(2, "0")}</span><label class="op-cmp"><input type="checkbox" data-cmp={p.slug} aria-label={`Compare ${p.name}`} /> Compare</label></div>
                <h3>{p.name}</h3>
                <p class="op-dev">{p.dev} &middot; Al Marjan Island</p>
                <p class="pnote">{p.note}</p>
                <dl>
                  <dt>From</dt><dd><span class="price op-price" data-aed={p.from}>{p.fromTxt}</span></dd>
                  <dt>Plan</dt><dd class="op-plan">{p.plan} <span class="op-bar" aria-hidden="true"><i style={`width:${a}%`}></i><i style={`width:${b}%`}></i></span></dd>
                  <dt>Unit mix</dt><dd>{p.mix}</dd>
                </dl>
                <div class="pcard-foot">
                  <a class="tlink" href={waText(`Hello RFR, please send me the brochure for ${p.name}.`)} target="_blank" rel="noopener"><span class="roll">Brochure &#8599;</span></a>
                  <a class="tlink" href={waText(`Hello RFR, what is still available at ${p.name}?`)} target="_blank" rel="noopener"><span class="roll">Availability &#8599;</span></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <div class="compare" id="compare" hidden>
        <div class="compare-head">
          <p class="small" id="cmp-label" style="margin:0">0 selected</p>
          <div class="actions">
            <button class="tlink" type="button" id="cmp-toggle" style="color:var(--gold)"><span class="roll">Compare side by side</span></button>
            <a class="tlink" id="cmp-wa" href="https://wa.me/971585015885" target="_blank" rel="noopener"><span class="roll">Ask about these &#8599;</span></a>
            <button class="tlink" type="button" id="cmp-clear"><span class="roll">Clear</span></button>
          </div>
        </div>
        <div class="compare-grid" id="cmp-grid"></div>
      </div>
    </div>
  </section>

  <section class="sec light" id="faq" aria-labelledby="faq-t">
    <div class="wrap faq-wrap">
      <div class="rv">
        <p class="kicker">( FAQ )</p>
        <h2 class="title" id="faq-t">Common <em>questions.</em></h2>
      </div>
      <div class="faq rv">
        <details><summary>What does off-plan mean?<span class="pm" aria-hidden="true"></span></summary><p>Off-plan means signing for a home before it&rsquo;s finished. You decide from renders, floor plans and a site visit, and pay in instalments as it&rsquo;s built.</p></details>
        <details><summary>What off-plan projects are there in Ras Al Khaimah?<span class="pm" aria-hidden="true"></span></summary><p>Nine current launches, all on Al Marjan Island, from developers including Emaar, Aldar, Ellington and Marriott, with starting prices from AED 920,000 to AED 4.06M.</p></details>
        <details><summary>Can foreigners buy off-plan on Al Marjan Island?<span class="pm" aria-hidden="true"></span></summary><p>Yes. Al Marjan Island is freehold, so foreign buyers can own off-plan units outright, the same as ready homes.</p></details>
        <details><summary>What payment plans do off-plan projects in Ras Al Khaimah offer?<span class="pm" aria-hidden="true"></span></summary><p>Current launches run from 50/50 to 80/20, meaning 50% to 80% is paid during construction and the rest on or after handover.</p></details>
        <details><summary>When do the off-plan launches hand over?<span class="pm" aria-hidden="true"></span></summary><p>Handovers in our current book range from Q4 2026 (Manta Bay, Sora Beach Residences, Masa Residence) to 2028 (Address Residences, Nikki Beach Residences, Costa Mare).</p></details>
        <details><summary>Do starting prices change with the floor, view and payment plan?<span class="pm" aria-hidden="true"></span></summary><p>Yes. Starting prices are the lowest entry point; floor, view and the payment plan chosen all move the final figure. We send exact unit-level pricing on request.</p></details>
      </div>
    </div>
  </section>

  <section class="sec dark cta-band" id="contact" aria-labelledby="cta-t">
    <div class="wrap cta-in">
      <div class="rv">
        <p class="kicker">Launches move fast</p>
        <h2 class="title" id="cta-t">Ask us what&rsquo;s still available <em>this week.</em></h2>
        <p class="lede">We&rsquo;ll send current availability, floor plans and the payment plan for any launch, and say plainly if we&rsquo;d skip it.</p>
      </div>
      <div class="cta-side rv">
        <div class="cline"><span>Call</span><b>+971 58 501 5885</b></div>
        <div class="cline"><span>WhatsApp</span><a class="ulink" href="https://wa.me/971585015885?text=Hello%20RFR%2C%20which%20off-plan%20launches%20on%20Al%20Marjan%20Island%20still%20have%20good%20units%3F" target="_blank" rel="noopener">Message directly &#8599;</a></div>
        <div class="cline"><span>Email</span><b>info@rfrrealestate.com</b></div>
        <div class="actions"><a class="pill on-dark" href="https://wa.me/971585015885?text=Hello%20RFR%2C%20which%20off-plan%20launches%20on%20Al%20Marjan%20Island%20still%20have%20good%20units%3F" target="_blank" rel="noopener"><span class="roll">WhatsApp an advisor</span><i class="pill-arrow" aria-hidden="true"></i></a></div>
      </div>
    </div>
  </section>
  <script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
