const H1 = "Investing in Ras Al Khaimah property: a 2026 guide for buyers and investors";
const IMAGE = `${SITE}/media/rak/rak-view-island-villas.jpg`;

const steps = [
  ["Set your budget and goal", "Decide whether the property is to live in, to rent out or for a Golden Visa, and include the 2% registration fee in the budget."],
  ["Shortlist an area", "Match the goal to the area: yield in Downtown RAK or Al Hamra Village, space in Mina Al Arab, resort-led off-plan on Al Marjan Island."],
  ["View the property", "In person, or on video if you are abroad."],
  ["Reserve and sign", "Agree the price and sign a memorandum of understanding (MOU) for a resale, or the developer’s sale and purchase agreement (SPA) for off-plan."],
  ["Get the developer NOC", "In freehold areas the developer issues a no-objection certificate before the transfer."],
  ["Transfer and register", "Complete the transfer at RAK Municipality, pay the registration fee and receive the title deed."],
  ["Take handover, or let it out", "Move in, or let our property management team find and manage tenants."],
];

const faqs = [
  ["Is Ras Al Khaimah a good place to buy property?", "It can be, for the right buyer. Foreigners can buy freehold in designated areas, there is no income or capital gains tax on UAE property, and AED 2M of property can qualify you for a Golden Visa. But 2026 price growth slowed, more than 34,000 new homes are expected by 2030, and nobody knows what Wynn will do to prices."],
  ["Can foreigners buy property in Ras Al Khaimah?", "Yes, in the designated freehold areas. Ras Al Khaimah Municipality lists them as Al Hamra Village, Mina Al Arab, Al Marjan Island, RAK Central, Julphar Towers, Al Maareedh (plots) and the upcoming Beach District. UAE and GCC nationals can buy anywhere in the Emirate."],
  ["How do I buy property in Ras Al Khaimah?", "Set your budget and goal, shortlist an area, view the property, reserve and sign (an MOU for a resale or the developer’s SPA for off-plan), get the developer’s NOC, then transfer and register at RAK Municipality, pay the registration fee and receive the title deed."],
  ["What government fees do I pay when buying in Ras Al Khaimah?", "The buyer pays a registration fee of 2% of the market value to RAK Municipality, plus AED 200 for plan issuance and AED 200 for the title deed. If you use a mortgage, its registration costs 0.1% of the loan. Agency commission and developer charges are separate."],
  ["What payment plans do off-plan projects in Ras Al Khaimah offer?", "Current launches run from 50/50 to 80/20, meaning 50% to 80% is paid during construction and the rest on or after handover."],
  ["Which area of Ras Al Khaimah has the highest rental yield?", "Downtown RAK and Al Hamra Village show the highest indicative gross yields in our book, around 7–9%, ahead of Al Marjan Island and Mina Al Arab."],
  ["Does buying property in Ras Al Khaimah give me a Golden Visa?", "It can. Property worth AED 2M or more can qualify you for a UAE Golden Visa, subject to the federal ICP rules at the time you apply. Official pages differ on whether the property route gives 5 or 10 years, so confirm the term with ICP or your RAK channel. RFR does not issue visas or give immigration advice. Full guide: Golden Visa through property in Ras Al Khaimah."],
];

