---
// Mina Al Arab area guide. Copy lives in ../mina-al-arab-main.html;
// the listing cards (same markup as /listings) are rendered here from
// data.js at build time, so they can't drift from the rest of the site.
// No off-plan launch in data.js is in Mina Al Arab (all nine are on Al Marjan
// Island, see /off-plan), so the page says so instead of showing launch cards.
import BaseLayout from "../layouts/BaseLayout.astro";
import rawHtml from "../mina-al-arab-main.html?raw";
import { RFR as R } from "../data.js";

const SITE = "https://www.rfrrealestate.com";
const PAGE = `${SITE}/mina-al-arab`;
const AREA = "mina-al-arab";
const area = R.areas.find((a) => a.slug === AREA);

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const aed = (n) => "AED " + Number(n).toLocaleString("en-US");
const SAVE_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>';

const listings = R.listings.filter((l) => l.area === AREA);
if (!listings.length) throw new Error("mina-al-arab: no listings in data.js");
// The copy and FAQ name these listings and say no off-plan launch is in Mina
// Al Arab. Fail the build if data.js changes, so the copy gets updated too.
const villa = listings.find((l) => l.slug === "villa-juwais");
const plot = listings.find((l) => l.slug === "plot-mina");
if (listings.length !== 2 || !villa || villa.cat !== "rent" || villa.price !== 84850 || !plot || plot.cat !== "buy" || plot.price != null)
  throw new Error("mina-al-arab: Mina Al Arab listings in data.js changed; update the copy and FAQ");
if (R.projects.length !== 9 || R.projects.some((p) => /mina al arab/i.test(JSON.stringify(p))))
  throw new Error("mina-al-arab: off-plan projects in data.js changed; update the off-plan copy and FAQ");

function listingCard(l) {
  const cat = l.offplan ? "Off-plan" : l.cat === "rent" ? "Rent" : "Buy";
  const price = l.price == null
    ? "<span>Price on request</span>"
    : `<span class="price" data-aed="${l.price}">${aed(l.price)}</span>${l.cat === "rent" ? " <small>/ yr</small>" : ""}`;
  // A plot has no bedrooms: show its size only, as /listings does.
  const facts = [/plot/i.test(l.type) ? null : l.beds ? `${l.beds} bed` : "Studio", l.baths ? `${l.baths} bath` : null, l.sqft ? `${Number(l.sqft).toLocaleString("en-US")} sq ft` : null].filter(Boolean).join(" &middot; ");
  const gal = l.gkey ? ` lgal" data-gallery="${esc(l.gkey)}` : "";
  return `        <article class="lcard rv" id="${esc(l.slug)}" data-slug="${esc(l.slug)}">
          <a class="lcard-link roll-host" href="listings.html#${esc(l.slug)}">
            <figure class="media${gal}"><img src="${esc(l.imgs[0])}" alt="${esc(l.title)}, ${esc(area.name)}" loading="lazy"><span class="ltag">${esc(l.status)}</span></figure>
            <p class="lmeta">${cat} &mdash; ${esc(area.name)}</p>
            <h3 class="lname"><span class="roll">${esc(l.title)}</span></h3>
            <p class="lprice">${price}</p>
            <p class="lfacts">${facts}</p>
          </a>
          <button class="save" type="button" data-save="${esc(l.slug)}" aria-pressed="false" aria-label="Save ${esc(l.title)}">${SAVE_SVG}<span>Save</span></button>
        </article>`;
}

const mainHtml = rawHtml.replace("<!--RFR:LISTING_CARDS-->", listings.map(listingCard).join("\n"));
if (mainHtml.includes("<!--RFR:")) throw new Error("mina-al-arab: card placeholder not replaced");

const listItem = (i, name, url) => ({ "@type": "ListItem", position: i + 1, name, url });

const faq = [
  ["Where is Mina Al Arab?", "On the coast of Ras Al Khaimah, UAE. It is a low-rise waterfront community built around lagoons and protected mangroves, about 15 minutes from RAK city centre and about 30 minutes from RAK Airport."],
  ["Can foreigners buy property in Mina Al Arab?", "Yes. Mina Al Arab is one of the designated freehold areas listed by Ras Al Khaimah Municipality, so foreign buyers can own property there outright."],
  ["How much does property in Mina Al Arab cost?", "Apartments start from about AED 800K, and villas run about AED 2.5–6M. A three-bedroom villa rents for about AED 85–140K a year, and indicative gross yields are 5.5–7%. Ranges are indicative, not a valuation; we send exact figures for any unit."],
  ["What property does RFR have for sale in Mina Al Arab?", "Right now we list a residential plot near the community pool for sale (price on request) and a three-bedroom villa to rent at AED 84,850 a year. We don’t list an off-plan project in Mina Al Arab at the moment; our nine off-plan launches are all on Al Marjan Island. Our book changes, so ask us what else is coming up."],
  ["How do I buy property in Mina Al Arab with RFR?", "Tell us your budget and whether you want to live, let or hold. We shortlist homes, run viewings in person or on video, and take you through reservation, the developer NOC and registration to the title deed. RFR Real Estate & Advisory works only in Ras Al Khaimah, and Mina Al Arab is one of the four areas we cover."],
];

const ldJson = [
  {"@context":"https://schema.org","@graph":[{"@type":["RealEstateAgent","LocalBusiness","Organization"],"@id":"https://www.rfrrealestate.com/#business","name":"RFR Real Estate & Advisory FZ-LLC","legalName":"RFR Real Estate & Advisory FZ-LLC","slogan":"Wherever you call home.","alternateName":["RFR","RFR Real Estate","RFR Real Estate & Advisory"],"url":"https://www.rfrrealestate.com/","logo":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","image":"https://www.rfrrealestate.com/media/rfr-logo-gold.webp","email":"info@rfrrealestate.com","telephone":"+971585015885","address":{"@type":"PostalAddress","addressLocality":"Ras Al Khaimah","addressRegion":"Ras Al Khaimah","addressCountry":"AE"},"areaServed":[{"@type":"AdministrativeArea","name":"Ras Al Khaimah"},{"@type":"Place","name":"Al Marjan Island"},{"@type":"Place","name":"Mina Al Arab"},{"@type":"Place","name":"Al Hamra Village"},{"@type":"Place","name":"Downtown Ras Al Khaimah"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"10:00","closes":"16:00"}],"priceRange":"AED 65,000/yr - AED 4,060,000","currenciesAccepted":"AED","knowsAbout":["Ras Al Khaimah real estate","Al Marjan Island","Off-plan property","Property management","UAE Golden Visa property investment"],"description":"RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.","disambiguatingDescription":"A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.","sameAs":["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]},{"@type":"WebSite","@id":"https://www.rfrrealestate.com/#website","name":"RFR Real Estate","alternateName":["RFR Real Estate & Advisory","RFR Real Estate & Advisory FZ-LLC","RFR","rfrrealestate.com"],"url":"https://www.rfrrealestate.com/","publisher":{"@id":"https://www.rfrrealestate.com/#business"},"inLanguage":"en"},
    {"@type":"BreadcrumbList","@id":`${PAGE}#breadcrumb`,"itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":`${SITE}/`},{"@type":"ListItem","position":2,"name":"Areas","item":`${SITE}/areas`},{"@type":"ListItem","position":3,"name":"Mina Al Arab","item":PAGE}]},
    {"@type":"Place","@id":`${PAGE}#place`,"name":"Mina Al Arab","url":PAGE,"description":"A low-rise waterfront community of villas, townhouses and lagoon-front apartments on the coast of Ras Al Khaimah, UAE, built around lagoons and protected mangroves. A designated freehold area.","geo":{"@type":"GeoCoordinates","latitude":area.lat,"longitude":area.lng},"image":`${SITE}/${area.img}`,"containedInPlace":{"@type":"AdministrativeArea","name":"Ras Al Khaimah","containedInPlace":{"@type":"Country","name":"United Arab Emirates"}}},
    {"@type":"WebPage","@id":`${PAGE}#webpage`,"url":PAGE,"name":"Mina Al Arab, Ras Al Khaimah: property for sale and how to buy","isPartOf":{"@id":`${SITE}/#website`},"publisher":{"@id":`${SITE}/#business`},"inLanguage":"en","datePublished":"2026-11-24","dateModified":"2026-11-27","primaryImageOfPage":{"@type":"ImageObject","url":`${SITE}/media/rfr/lagoon-palms.jpg`},"about":{"@id":`${PAGE}#place`},"breadcrumb":{"@id":`${PAGE}#breadcrumb`}}]},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(([q, a]) => ({"@type":"Question","name":q,"acceptedAnswer":{"@type":"Answer","text":a}}))},
  {"@context":"https://schema.org","@type":"ItemList","@id":`${PAGE}#listings`,"name":"Property listed by RFR in Mina Al Arab","url":`${PAGE}#listings`,"numberOfItems":listings.length,"itemListElement":listings.map((l, i) => listItem(i, `${l.title}, ${area.name}`, `${SITE}/listings#${l.slug}`))},
];
---
<BaseLayout page="mina-al-arab" title={"Mina Al Arab Property for Sale | RFR Real Estate"} description={"Mina Al Arab, Ras Al Khaimah: villas, townhouses, apartments and plots in a freehold lagoon community. What RFR lists there, how to buy property, and an FAQ."} path="/mina-al-arab" ldJson={ldJson}>
<Fragment set:html={mainHtml} />
<script slot="pre-script" src="data.js" is:inline></script>
</BaseLayout>
