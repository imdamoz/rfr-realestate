  {"@context":"https://schema.org","@type":"DefinedTermSet","@id":"https://www.rfrrealestate.com/services#glossary","name":"Ras Al Khaimah property glossary","inDefinedTermSet":"https://www.rfrrealestate.com/services#glossary","hasDefinedTerm":[{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#freehold","name":"Freehold","description":"Full, outright ownership of a property, available to foreign buyers in the designated freehold areas, including Al Marjan Island, Mina Al Arab and Al Hamra Village; in Downtown RAK, only in designated projects such as Julphar Towers and RAK Central."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#off-plan","name":"Off-plan","description":"Buying a home before it is built, from renders and floor plans, usually paid in instalments as construction progresses."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#payment-plan","name":"Payment plan","description":"The instalment schedule for an off-plan purchase, for example 60/40, meaning 60% paid during construction and 40% on or after handover."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#handover","name":"Handover","description":"The date a developer hands over keys to the buyer, when the balance payment is usually due."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#golden-visa","name":"Golden Visa","description":"A long-term UAE residency visa. Property worth AED 2 million or more can qualify, subject to the federal ICP rules at the time you apply."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#gross-yield","name":"Gross yield","description":"Annual rent divided by purchase price, before costs like service charges and management fees."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#net-yield","name":"Net yield","description":"Annual rent minus running costs, divided by purchase price: a more realistic return figure than gross yield."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#service-charge","name":"Service charge","description":"The annual fee owners pay for the upkeep of shared building and community facilities."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#title-deed","name":"Title deed","description":"The government-issued document proving ownership of a property, registered with the RAK Land Department."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#noc","name":"NOC (no-objection certificate)","description":"A certificate from the developer confirming no debts are owed on a unit, required before a resale can transfer."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#agency-commission","name":"Agency commission","description":"The fee paid to an agency for a sale or lease, typically around 2% for sales and 5% for leasing in Ras Al Khaimah, plus VAT."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#branded-residence","name":"Branded residence","description":"A home managed under a hotel or hospitality brand, such as Nobu or Marriott, often with access to hotel-style services."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#rental-pool","name":"Rental pool","description":"A scheme where owners in a building share rental income from a shared booking and management system, rather than letting individually."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#registration-fee","name":"Registration fee","description":"A government fee paid to the RAK Land Department when a property sale is registered, on top of the purchase price."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#resale","name":"Resale","description":"A property bought from its current owner rather than directly from the developer, as opposed to an off-plan or first-hand purchase."},{"@type":"DefinedTerm","@id":"https://www.rfrrealestate.com/services#holiday-let","name":"Holiday let","description":"A furnished home rented out short-term to visitors, common on Al Marjan Island near the resorts."}]}
