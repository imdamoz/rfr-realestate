---
import BaseLayout from "../layouts/BaseLayout.astro";
const ldJson = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["RealEstateAgent", "LocalBusiness"],
        "@id": "https://www.rfrrealestate.com/#business",
        "name": "RFR Real Estate & Advisory FZ-LLC",
        "alternateName": ["RFR", "RFR Real Estate", "RFR Real Estate & Advisory"],
        "url": "https://www.rfrrealestate.com/",
        "logo": "https://www.rfrrealestate.com/media/rfr-logo-gold.webp",
        "image": "https://www.rfrrealestate.com/media/rfr-logo-gold.webp",
        "email": "info@rfrrealestate.com",
        "telephone": "+971585015885",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ras Al Khaimah",
          "addressRegion": "Ras Al Khaimah",
          "addressCountry": "AE"
        },
        "areaServed": [
          { "@type": "AdministrativeArea", "name": "Ras Al Khaimah" },
          { "@type": "Place", "name": "Al Marjan Island" },
          { "@type": "Place", "name": "Mina Al Arab" },
          { "@type": "Place", "name": "Al Hamra Village" },
          { "@type": "Place", "name": "Downtown Ras Al Khaimah" }
        ],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "18:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Saturday",
            "opens": "10:00",
            "closes": "16:00"
          }
        ],
        "priceRange": "AED 65,000/yr - AED 4,060,000",
        "currenciesAccepted": "AED",
        "knowsAbout": [
          "Ras Al Khaimah real estate",
          "Al Marjan Island",
          "Off-plan property",
          "Property management",
          "UAE Golden Visa property investment"
        ],
        "description": "RFR Real Estate & Advisory FZ-LLC is a licensed real estate brokerage and advisory firm in Ras Al Khaimah, UAE. It works only in Ras Al Khaimah: Al Marjan Island, Mina Al Arab, Al Hamra Village and Downtown RAK.",
        "disambiguatingDescription": "A Ras Al Khaimah (UAE) real estate agency. Not RFR Holding, the New York real estate company.",
        "sameAs": ["https://www.propertyfinder.ae/en/broker/rfr-real-estate-v2-13173-13173"]
      },
      {
        "@type": "WebSite",
        "@id": "https://www.rfrrealestate.com/#website",
        "name": "RFR Real Estate",
        "url": "https://www.rfrrealestate.com/",
        "publisher": { "@id": "https://www.rfrrealestate.com/#business" },
        "inLanguage": "en"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.rfrrealestate.com/" },
          { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.rfrrealestate.com/services" }
        ]
      }
    ]
  }
];
---
<BaseLayout page="services" title="Services | RFR Real Estate" description="Property management, investment consultation, and sales and leasing in Ras Al Khaimah." path="/services" ldJson={ldJson}>
  <section class="phx hx has-bar" aria-labelledby="sv-t">
    <div class="phx-bg" aria-hidden="true"><img class="is-on" src="media/hd/tower.jpg" alt="" fetchpriority="high"></div>
    <div class="wrap hx-in">
      <h1 class="giant sand hx-t" id="sv-t" data-split>Buy, let or manage</h1>
      <div class="hx-block">
        <p class="hx-label">With one team</p>
        <p class="hx-text">Sales, lettings, management and investment advice in Ras Al Khaimah, with one advisor as your contact from start to finish.</p>
        <a class="pill solid" href="#contact"><span class="roll">Talk to an advisor</span><i class="pill-arrow" aria-hidden="true"></i></a>
      </div>
    </div>
    <ol class="phx-bar"><li><a class="roll-host" href="#management"><small>01</small><span><span class="roll">Property management</span></span><i aria-hidden="true">&#8599;</i></a></li><li><a class="roll-host" href="#investment"><small>02</small><span><span class="roll">Investment consultation</span></span><i aria-hidden="true">&#8599;</i></a></li><li><a class="roll-host" href="#sales"><small>03</small><span><span class="roll">Sales &amp; leasing</span></span><i aria-hidden="true">&#8599;</i></a></li></ol>

  </section>

  <section class="sec light svc-sec" id="management" aria-labelledby="management-t">
    <div class="wrap svc-block">
      <figure class="media svc-block-media rv"><img src="media/rfr/falcon-3.jpg" alt="A furnished living room on Falcon Island" loading="lazy"><span class="svc-big" aria-hidden="true">/ 01</span></figure>
      <div class="rv">
        <p class="svc-name">/ 01 &middot; Property management</p>
        <h2 class="svc-h" id="management-t">Ownership without <em>the 3am phone calls.</em></h2>
        <p class="body-t" style="max-width:52ch">We find the tenants, collect the rent, sort out repairs and send you a clear statement every quarter. One contact handles all of it.</p>
        <ul class="svc-pts"><li><i>a.</i><b>Day-to-day running</b>Rent, bills, renewals and the building management.</li><li><i>b.</i><b>Finding tenants</b>Advertising, viewings and proper checks.</li><li><i>c.</i><b>Repairs</b>Contractors we know, and quotes before big jobs.</li><li><i>d.</i><b>Statements</b>Money in and money out, every quarter.</li></ul>
        <a class="pill solid" href="#contact" data-tab="enquiry" data-service="Property management"><span class="roll">Get a management quote</span><i class="pill-arrow" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section class="sec light-2 svc-sec" id="investment" aria-labelledby="investment-t">
    <div class="wrap svc-block flip">
      <figure class="media svc-block-media rv"><img src="media/rak/rak-dream-island.jpg" alt="Dream Island, Al Marjan, from the air" loading="lazy"><span class="svc-big" aria-hidden="true">/ 02</span></figure>
      <div class="rv">
        <p class="svc-name">/ 02 &middot; Investment consultation</p>
        <h2 class="svc-h" id="investment-t">Work out the plan <em>before you buy.</em></h2>
        <p class="body-t" style="max-width:52ch">First we ask what you want the property to do for you: rental income, growth, or a Golden Visa. Then we show you which options fit and which don’t.</p>
        <ul class="svc-pts"><li><i>a.</i><b>Is it a good buy?</b>Price against recent sales, realistic rent, service charge and risks.</li><li><i>b.</i><b>Own several?</b>How each one is doing, and when to sell.</li><li><i>c.</i><b>Staying current</b>New launches, rule changes and prices, <a class="ulink" href="market.html">once a month</a>.</li></ul>
        <a class="pill solid" href="#contact" data-tab="enquiry" data-service="Investment consultation"><span class="roll">Book a free consultation</span><i class="pill-arrow" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section class="sec light svc-sec" id="sales" aria-labelledby="sales-t">
    <div class="wrap svc-block">
      <figure class="media svc-block-media rv"><img src="media/rfr/onebed-3.jpg" alt="A bright living and dining room" loading="lazy"><span class="svc-big" aria-hidden="true">/ 03</span></figure>
      <div class="rv">
        <p class="svc-name">/ 03 &middot; Sales &amp; leasing</p>
        <h2 class="svc-h" id="sales-t">From first viewing to <em>final signature.</em></h2>
        <p class="body-t" style="max-width:52ch">Whether you’re buying, selling, letting out or renting, we find the options, negotiate for you and see it through to the keys.</p>
        <ul class="svc-pts"><li><i>a.</i><b>Buying and selling</b>Finding the property or buyer, negotiating and the transfer.</li><li><i>b.</i><b>Renting</b>Good tenants for landlords; shortlists and viewings for tenants.</li><li><i>c.</i><b>Off-plan</b>Which <a class="ulink" href="off-plan.html">launches</a> are worth it, and which payment plan suits you.</li></ul>
        <a class="pill solid" href="#contact" data-tab="enquiry" data-service="Sales &amp; leasing"><span class="roll">Start a search</span><i class="pill-arrow" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section class="sec light-2 process-sec" id="process" aria-labelledby="process-t">
    <div class="wrap">
      <div class="process rv">
        <div class="process-head">
          <p class="kicker">( 04 ) The process</p>
          <h2 class="title sm" id="process-t">How it <em>works.</em></h2>
        </div>
        <ol class="process-steps">
          <li style="--d:0"><span class="n">01</span><b>Shortlist</b><p>Built from what&rsquo;s actually available, priced and worth your time.</p></li>
          <li style="--d:1"><span class="n">02</span><b>Viewings</b><p>We walk the units with you, or for you on camera if you&rsquo;re overseas.</p></li>
          <li style="--d:2"><span class="n">03</span><b>Negotiation</b><p>Terms, price and paperwork handled on your side of the table.</p></li>
          <li style="--d:3"><span class="n">04</span><b>Signing, and after</b><p>Settlement, handover, and the same advisor answering the phone afterwards.</p></li>
        </ol>
        <p class="fees-line"><span>Fees, plainly</span> Management from 5% of annual rent &middot; Sales 2% &middot; Leasing 5% <small>+ VAT. In writing before we start, with nothing hidden in the service charge.</small></p>
      </div>
    </div>
  </section>

  <section class="sec dark" id="contact" aria-labelledby="ct-t">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <p class="kicker">( 05 ) Private enquiry</p>
          <h2 class="title" id="ct-t">Tell us <em>what you need.</em></h2>
        </div>
        <p class="lede">A line or two is plenty. An advisor will reply the same day with a clear next step.</p>
      </div>
      <div class="contact">
        <div class="rv">
          <form class="form" id="enquiryForm" data-kind="enquiry">
            <label><span>Name</span><input id="eq-name" name="Name" required autocomplete="name"></label>
            <label><span>Email</span><input id="eq-email" name="Email" type="email" autocomplete="email"></label>
            <label><span>Phone</span><input id="eq-phone" name="Phone" type="tel" autocomplete="tel"></label>
            <label><span>Which service</span><select id="eq-service" name="Service"><option>Property management</option><option>Investment consultation</option><option>Sales &amp; leasing</option></select></label>
            <label class="full"><span>What you need</span><textarea id="eq-need" name="What I need" rows="3"></textarea></label>
            <div class="form-foot">
              <span class="small">Goes straight to an advisor &middot; never shared</span>
              <button class="btn solid" type="submit"><span class="roll">Send enquiry &#8599;</span></button>
            </div>
          </form>
        </div>
        <aside class="advisor rv" aria-label="Talk to an advisor">
          <figure class="media zoom"><img src="media/rak/rak-view-island-villas.jpg" alt="Beachfront villas on View Island, Al Marjan, visualisation" loading="lazy"></figure>
          <div class="advisor-body">
            <p class="kicker">Fees, plainly</p>
            <p class="h">In writing before we start. Replies within the day.</p>
            <div class="cline"><span>Call</span><b>+971 58 501 5885</b></div>
            <div class="cline"><span>WhatsApp</span><a class="ulink" href="https://wa.me/971585015885" target="_blank" rel="noopener">Message directly &#8599;</a></div>
            <div class="cline"><span>Email</span><b>info@rfrrealestate.com</b></div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
