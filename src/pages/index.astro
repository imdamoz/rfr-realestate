  /* services intro + the two-up panel, then How it works as its own screen */
  #services .sec-head { margin-bottom: clamp(14px, 2.6vh, 36px); }
  #services .giant.md { font-size: clamp(40px, min(4.6vw, 8vh), 92px); }
  .wing { min-height: 0; height: auto; margin-bottom: 0; }
  .wing-panel { padding: clamp(22px, 3.4vh, 56px) clamp(24px, 3vw, 56px); }
  .wing-panel .bl-item { font-size: clamp(24px, min(2.3vw, 4.1vh), 40px); line-height: 1.12; }
  .wing-panel .svc-h { font-size: clamp(26px, min(2.3vw, 4.1vh), 40px); }
