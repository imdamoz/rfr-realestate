  var scroller = document.getElementById("scroller");
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  var WA = "https://wa.me/971585015885";
  function $(s, r) { return (r || document).querySelector(s); }
  function $$(s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function waText(t) { return WA + "?text=" + encodeURIComponent(t); }

  // ---------- Text roll: wrap each label so a copy can roll in from below ----------
  function wireRolls(root) {
    $$(".roll", root).forEach(function (el) {
      if (el.querySelector(".roll__in")) return;
      var label = el.textContent.replace(/\s+/g, " ").trim();
      var inner = document.createElement("span");
      inner.className = "roll__in";
      inner.setAttribute("data-label", label);
      while (el.firstChild) inner.appendChild(el.firstChild);
      el.appendChild(inner);
    });
  }
  wireRolls(document);

  // ---------- Reveal on scroll (visible at rest; only the offset animates) ----------
  if (!reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js-rv");
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { root: scroller, rootMargin: "0px 0px -6% 0px", threshold: 0.06 });
    $$(".rv").forEach(function (el) { io.observe(el); });
  }

  // ---------- Image peek that follows the cursor over the area and launch lists ----------
  var peek = $("#peek"), peekImg = peek && $("img", peek), px = 0, py = 0, tx = 0, ty = 0, peekOn = false;
  if (fine && peek) {
    $$("[data-peek]").forEach(function (el) {
      el.addEventListener("mouseenter", function () { peekImg.src = el.getAttribute("data-peek"); peek.classList.add("on"); peekOn = true; });
      el.addEventListener("mouseleave", function () { peek.classList.remove("on"); peekOn = false; });
      el.addEventListener("mousemove", function (e) { tx = e.clientX + 170; ty = e.clientY; if (tx > window.innerWidth - 150) tx = e.clientX - 170; });
    });
    (function loop() {
      px += (tx - px) * 0.16; py += (ty - py) * 0.16;
      if (peekOn || peek.classList.contains("on")) peek.style.left = px + "px", peek.style.top = py + "px";
      requestAnimationFrame(loop);
    })();
  }

  // ---------- Services: sticky image follows the item in view or under the cursor ----------
  var svcImg = $("#svcImg"), items = $$(".svc-item");
  function setSvc(item) {
    if (!item || item.classList.contains("active")) return;
    items.forEach(function (x) { x.classList.toggle("active", x === item); });
    if (!svcImg) return;
    svcImg.classList.add("swap");
    setTimeout(function () { svcImg.src = item.getAttribute("data-img"); svcImg.classList.remove("swap"); }, reduce ? 0 : 280);
  }
  if ("IntersectionObserver" in window && items.length) {
    var sio = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) setSvc(e.target); }); }, { root: scroller, rootMargin: "-45% 0px -45% 0px" });
    items.forEach(function (it) { sio.observe(it); if (fine) it.addEventListener("mouseenter", function () { setSvc(it); }); });
  }

  // ---------- Costs calculator ----------
  var calc = $("#calc");
  if (calc) {
    var f = function (n) { return "AED " + Math.round(n).toLocaleString("en-US"); };
    var ids = ["price", "dep", "rate", "term", "yield", "size", "sc"];
    var inp = {}; ids.forEach(function (k) { inp[k] = $("#c-" + k); });
    function run() {
      var price = +inp.price.value, depPct = +inp.dep.value / 100, rate = +inp.rate.value / 100, term = +inp.term.value,
          gy = +inp.yield.value / 100, size = +inp.size.value, sc = +inp.sc.value;
      ids.forEach(function (k) { var el = inp[k]; el.style.setProperty("--fill", ((el.value - el.min) / (el.max - el.min) * 100) + "%"); });
      $("#o-price").textContent = f(price);
      $("#o-dep").textContent = Math.round(depPct * 100) + "% · " + f(price * depPct);
      $("#o-rate").textContent = (rate * 100).toFixed(2) + "%";
      $("#o-term").textContent = term + " years";
      $("#o-yield").textContent = (gy * 100).toFixed(1) + "%";
      $("#o-size").textContent = size.toLocaleString("en-US") + " sq ft";
      $("#o-sc").textContent = "AED " + sc.toFixed(sc % 1 ? 1 : 0) + " / sq ft";
      var deposit = price * depPct, transfer = price * 0.04, agency = price * 0.02 * 1.05;
      var total = deposit + transfer + agency;
      var loan = price - deposit, r = rate / 12, n = term * 12;
      var monthly = loan > 0 ? (r > 0 ? loan * r / (1 - Math.pow(1 + r, -n)) : loan / n) : 0;
      var rent = price * gy, service = size * sc, mort = monthly * 12, net = rent - service - mort;
      $("#r-total").textContent = f(total);
      $("#r-dep").textContent = f(deposit);
      $("#r-transfer").textContent = f(transfer) + " + admin";
      $("#r-agency").textContent = f(agency);
      $("#r-rent").textContent = f(rent);
      $("#r-sc").textContent = "− " + f(service);
      $("#r-mort").textContent = loan > 0 ? "− " + f(mort) : "None (cash)";
      var netEl = $("#r-net"); netEl.textContent = (net < 0 ? "− " : "") + f(Math.abs(net)); netEl.classList.toggle("neg", net < 0);
      var y = total > 0 ? net / total * 100 : 0;
      var yEl = $("#r-yield"); yEl.textContent = y.toFixed(1) + "%"; yEl.classList.toggle("neg", y < 0);
      $("#r-month").textContent = loan > 0 ? f(monthly) : "—";
    }
    calc.addEventListener("input", run); run();
  }

  // ---------- Client quotes ----------
  var quotes = $$("#quotes .quote"), qi = 0, qTimer = null;
  function showQ(i) {
    qi = (i + quotes.length) % quotes.length;
    quotes.forEach(function (q, k) { q.classList.toggle("on", k === qi); q.setAttribute("aria-hidden", String(k !== qi)); });
    $("#qCount").textContent = String(qi + 1).padStart(2, "0") + " / " + String(quotes.length).padStart(2, "0");
  }
  function restartQ() { if (reduce) return; clearInterval(qTimer); qTimer = setInterval(function () { showQ(qi + 1); }, 8000); }
  if (quotes.length) {
    $("#qPrev").addEventListener("click", function () { showQ(qi - 1); restartQ(); });
    $("#qNext").addEventListener("click", function () { showQ(qi + 1); restartQ(); });
    restartQ();
  }

  // ---------- Contact tabs + links that open a tab ----------
  var tabs = $$(".tab");
  function selectTab(name, service) {
    tabs.forEach(function (t) {
      var on = t.id === "tab-" + name;
      t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1;
      $("#" + t.getAttribute("aria-controls")).hidden = !on;
    });
    if (service) { var s = $("#eq-service"); if (s) s.value = service; }
  }
  tabs.forEach(function (t, i) {
    t.addEventListener("click", function () { selectTab(t.id.replace("tab-", "")); });
    t.addEventListener("keydown", function (e) {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      var n = tabs[(i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length]; n.focus(); n.click();
    });
  });
  document.addEventListener("click", function (e) {
    var a = e.target.closest("[data-tab]"); if (!a) return;
    selectTab(a.getAttribute("data-tab"), a.getAttribute("data-service"));
  });

  // ---------- FAQ: one question open at a time; answers slide open and closed ----------
  function faqSlide(d, opening) {
    var body = d.querySelector("summary + *");
    if (d._anim) d._anim.cancel();
    if (d._fade) d._fade.cancel();
    var start = d.getBoundingClientRect().height;               // from where it is now, even mid-way
    if (opening) d.open = true;
    d.classList.toggle("is-closing", !opening);
    var end = opening ? d.offsetHeight : d.querySelector("summary").offsetHeight + (d.offsetHeight - d.clientHeight);
    d.style.overflow = "hidden";
    var a = d._anim = d.animate({ height: [start + "px", end + "px"] }, { duration: opening ? 420 : 340, easing: "cubic-bezier(.4, 0, .2, 1)" });
    if (body) d._fade = body.animate(opening ? { opacity: [0, 1], transform: ["translateY(-6px)", "none"] } : { opacity: [1, 0] }, { duration: opening ? 420 : 260, easing: "ease-out", fill: "both" });
    a.onfinish = function () {
      d._anim = null; d.style.overflow = "";
      if (!opening) { d.open = false; d.classList.remove("is-closing"); }
      if (d._fade) { d._fade.cancel(); d._fade = null; }
    };
  }
  document.addEventListener("click", function (e) {
    var sum = e.target.closest && e.target.closest(".faq summary"), d = sum && sum.parentElement;
    if (!d || d.tagName !== "DETAILS") return;
    e.preventDefault();
    var opening = !d.open || d.classList.contains("is-closing");
    var others = Array.prototype.filter.call(d.parentElement.children, function (x) { return x !== d && x.tagName === "DETAILS" && x.open && !x.classList.contains("is-closing"); });
    if (reduce || !d.animate) { others.forEach(function (x) { x.open = false; }); d.open = opening; return; }
    if (opening) others.forEach(function (x) { faqSlide(x, false); });
    faqSlide(d, opening);
  });

  // ---------- Forms: build the brief and hand it to WhatsApp (the site's own flow) ----------
  $$("form.form").forEach(function (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (!form.reportValidity()) return;
      var lines = [form.getAttribute("data-kind") === "review" ? "Hello RFR — I’d like a free property performance review." : "Hello RFR — private enquiry."];
      $$("select, input, textarea", form).forEach(function (el) { if (el.value) lines.push(el.name + ": " + el.value); });
      var href = waText(lines.join("\n"));
      var old = $(".sent", form); if (old) old.remove();
      var box = document.createElement("div");
      box.className = "sent"; box.setAttribute("role", "status");
      box.innerHTML = "Your brief is ready in WhatsApp. Press send there and it comes straight to our team. <a href=\"" + href + "\" target=\"_blank\" rel=\"noopener\">Open WhatsApp &#8599;</a><br><span class=\"small\">Or call +971 58 501 5885</span>";
      form.appendChild(box);
    });
  });
  var nl = $("#nlForm");
  if (nl) nl.addEventListener("submit", function (e) {
    e.preventDefault(); if (!nl.reportValidity()) return;
    var em = $("#nl-email").value;
    $("#nlMsg").innerHTML = "Almost done: <a style=\"color:var(--gold)\" target=\"_blank\" rel=\"noopener\" href=\"" + waText("Hello RFR — please send me your monthly note on RAK prices, rents and new launches. My email: " + em) + "\">send the request on WhatsApp &#8599;</a>";
  });

  // ---------- Currency switch (indicative rates; AED is pegged to USD at 3.6725) ----------
  var RATES = { AED: 1, USD: 3.6725, EUR: 4.25, GBP: 4.9 };
  var NAMES = { AED: "UAE dirham", USD: "US dollar", EUR: "Euro", GBP: "British pound" };
  var cur = "AED";
  try { var savedCur = localStorage.getItem("rfrCur"); if (savedCur && RATES[savedCur]) cur = savedCur; } catch (e) {}
  function money(aed, code) {
    var v = aed / RATES[code];
    if (v >= 1e6) return code + " " + (v / 1e6).toFixed(2) + "M";
    return code + " " + Math.round(v).toLocaleString("en-US");
  }
  function applyCurrency(root) {
    $$(".price[data-aed]", root).forEach(function (el) {
      if (!el.hasAttribute("data-orig")) el.setAttribute("data-orig", el.textContent);
      el.textContent = cur === "AED" ? el.getAttribute("data-orig") : money(+el.getAttribute("data-aed"), cur);
    });
  }
  var curBtn = $("#cur-btn"), curMenu = $("#cur-menu");
  if (curBtn && curMenu) {
    curMenu.innerHTML = Object.keys(RATES).map(function (c) {
      return '<button type="button" role="menuitemradio" aria-checked="' + (c === cur) + '" data-cur="' + c + '"><b>' + c + '</b><span>' + NAMES[c] + '</span></button>';
    }).join("") + "<p>Converted at indicative rates. Prices are set in AED.</p>";
    curBtn.setAttribute("aria-haspopup", "menu"); curBtn.setAttribute("aria-expanded", "false");
    curBtn.addEventListener("click", function (e) { e.stopPropagation(); var open = curMenu.hidden; curMenu.hidden = !open; curBtn.setAttribute("aria-expanded", String(open)); });
    curMenu.addEventListener("click", function (e) {
      var b = e.target.closest("[data-cur]"); if (!b) return;
      cur = b.getAttribute("data-cur"); curBtn.textContent = cur; curBtn.setAttribute("aria-label", "Currency: " + cur);
      $$("[data-cur]", curMenu).forEach(function (x) { x.setAttribute("aria-checked", String(x === b)); });
      curMenu.hidden = true; curBtn.setAttribute("aria-expanded", "false");
      try { localStorage.setItem("rfrCur", cur); } catch (err) {}
      applyCurrency(document);
    });
    if (cur !== "AED") { curBtn.textContent = cur; curBtn.setAttribute("aria-label", "Currency: " + cur); applyCurrency(document); }
    document.addEventListener("click", function (e) { if (!curMenu.hidden && !e.target.closest(".cur-wrap")) { curMenu.hidden = true; curBtn.setAttribute("aria-expanded", "false"); } });
  }
  window.rfrApplyCurrency = applyCurrency;

  // ---------- Side menu ----------
  var side = $("#side"), menuBtn = $("#menu-btn");
  function setSide(open) {
    side.classList.toggle("open", open); side.setAttribute("aria-hidden", String(!open));
    if (open) { var c = $(".side-close", side); setTimeout(function () { c.focus(); }, 50); } else if (menuBtn) menuBtn.focus();
  }
  if (side && menuBtn) {
    menuBtn.setAttribute("aria-expanded", "false"); menuBtn.setAttribute("aria-controls", "side");
    menuBtn.addEventListener("click", function () { setSide(true); menuBtn.setAttribute("aria-expanded", "true"); });
    $$("[data-close]", side).forEach(function (b) { b.addEventListener("click", function () { setSide(false); menuBtn.setAttribute("aria-expanded", "false"); }); });
    $$(".side-nav a", side).forEach(function (a) { a.addEventListener("click", function () { side.classList.remove("open"); side.setAttribute("aria-hidden", "true"); menuBtn.setAttribute("aria-expanded", "false"); }); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && side.classList.contains("open")) { setSide(false); menuBtn.setAttribute("aria-expanded", "false"); } });
  }
})();

  // Footer wordmark: scale to fit the column on any font / width
  (function () {
    var mark = document.querySelector(".foot-mark");
    if (!mark) return;
    function fit() {
      mark.style.fontSize = "";
      var w = mark.clientWidth, sw = mark.scrollWidth;
      if (sw > w + 1) mark.style.fontSize = (parseFloat(getComputedStyle(mark).fontSize) * (w / sw) * 0.99).toFixed(2) + "px";
    }
    fit();
    window.addEventListener("resize", fit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  })();
