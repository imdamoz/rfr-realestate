  /* about: the collage fills exactly one screen */
  .roots-in { min-height: var(--fit); }
  .roots-copy { padding-top: clamp(20px, 4vh, 64px); }

  /* about, continued: facts + experience, then the team as its own screen */
  .facts { margin-bottom: clamp(18px, 3.8vh, 64px); }
  .facts div { padding-block: clamp(12px, 2vh, 26px); }
  .exp .media { aspect-ratio: auto; height: clamp(240px, 50vh, 520px); }
  .exp-pts { margin-top: clamp(14px, 2.4vh, 30px); }
  .exp-pts li { padding: clamp(8px, 1.4vh, 18px) 0; }
  .exp-pts b { font-size: clamp(20px, 2.8vh, 25px); }
  .team-head { margin: 0 0 clamp(16px, 3vh, 48px); }
  .team .portrait { aspect-ratio: auto; height: clamp(200px, 44vh, 470px); margin-bottom: 10px; }

  /* market note, then What it means for you as its own screen */
  .note-side .media { aspect-ratio: auto; height: min(var(--fit), 660px); }
  .chapters { margin-top: clamp(14px, 2.6vh, 44px); }
  .chapter summary { padding: clamp(10px, 1.7vh, 24px) 0; }
  .chapter .k { margin-bottom: 4px; }
  .chapter .h { font-size: clamp(19px, min(1.8vw, 3.2vh), 28px); }
  .chapter .body { padding-bottom: clamp(12px, 2vh, 26px); gap: 10px; }
