  .calc-out { padding: clamp(16px, 2.6vh, 44px) clamp(22px, 2.4vw, 44px); }
  .calc-total { padding-bottom: clamp(10px, 1.9vh, 26px); }
  .calc-total strong { font-size: clamp(34px, min(4vw, 6.4vh), 70px); margin-top: 6px; }
  .calc-group { padding: clamp(6px, 1.3vh, 22px) 0 2px; }
