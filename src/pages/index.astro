  .foryou { margin-top: 0; }
  .foryou article { padding: clamp(18px, 3vh, 30px) 26px; }
  .newsletter { margin-top: clamp(22px, 4.4vh, 72px); padding: clamp(20px, 3.4vh, 48px); }

  /* questions */
  .faq summary { padding: clamp(12px, 2.1vh, 26px) 0; font-size: clamp(19px, min(2vw, 3.3vh), 29px); }

  /* contact */
  .tabs { margin-bottom: clamp(16px, 3vh, 40px); }
  .form label { padding: clamp(6px, 1.15vh, 14px) 0 clamp(5px, .9vh, 10px); }
  .form textarea { min-height: clamp(44px, 7vh, 70px); }
  .form-foot { margin-top: clamp(14px, 2.4vh, 30px); }
  .advisor .media { aspect-ratio: auto; height: clamp(130px, 22vh, 260px); }
  .advisor-body { padding: clamp(16px, 2.4vh, 26px); }

  /* footer */
  .foot { padding-top: var(--sec-pt); }
  .foot-grid { padding-bottom: clamp(28px, 5vh, 96px); }
}
