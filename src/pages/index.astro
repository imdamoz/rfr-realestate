  .giant.md { font-size: clamp(44px, min(6vw, 10.4vh), 116px); }
  .giant-sub { font-size: clamp(22px, min(2.2vw, 3.8vh), 38px); margin-top: 6px !important; }
  .title { font-size: clamp(38px, min(4.6vw, 8.2vh), 84px); }
  .title.sm { font-size: clamp(26px, min(2.9vw, 5.2vh), 50px); }
  .sec-head { margin-bottom: clamp(18px, 3.6vh, 52px); }
  .actions { margin-top: clamp(16px, 2.8vh, 34px); }
  .lede { line-height: 1.55; }


  /* Buy / Sell / Lease: one full screen, like Areas */
  .paths-sec { padding-block: 0; }
  .paths-sec .paths2 { margin: 0; min-height: var(--scr); padding-top: var(--sec-pt); padding-bottom: var(--sec-pb); }
  .around { min-height: var(--scr); padding-top: var(--sec-pt); padding-bottom: var(--sec-pb); }

  /* listings */
  #listings .ghead { margin-bottom: clamp(14px, 2.6vh, 36px); }
  #listings .ghead .giant { max-width: none; white-space: nowrap; }
  #listings .ghead-card { width: clamp(140px, min(16vw, 23vh), 250px); top: -18%; }
  #listings .ghead-lede { margin-top: clamp(8px, 1.6vh, 22px); }
  .finder label { padding: clamp(8px, 1.3vh, 16px) 18px; }
  .finder .btn { min-height: clamp(48px, 7vh, 72px); }
  .lgrid { margin-top: clamp(14px, 2.6vh, 32px); }
  .lcard .media { aspect-ratio: auto; height: clamp(140px, 25vh, 300px); }
  .lfoot { margin-top: clamp(16px, 2.8vh, 40px); padding-top: clamp(12px, 2vh, 24px); }
  .lfoot .title.sm { font-size: clamp(22px, min(2.2vw, 4vh), 36px); }

  /* why Ras Al Khaimah: exactly one screen */
  .sec.band { min-height: 0; height: var(--scr); padding-block: var(--sec-pt) var(--sec-pb); }
