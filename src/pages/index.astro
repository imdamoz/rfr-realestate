/* v2 interactions: giant letters, word-by-word statements, wipe reveals, parallax, lists with swapping images, floating cards. */
(function () {
  "use strict";
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var scroller = document.getElementById("scroller") || window;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  document.documentElement.classList.add("js-v2");

  // ---- split giant words into letters ----
  $$(".giant[data-split]").forEach(function (el) {
    var words = el.textContent.trim().split(/\s+/), k = 0;
    el.setAttribute("aria-label", el.textContent.trim());
    el.innerHTML = words.map(function (w) {
      return '<span class="gw" aria-hidden="true">' + w.split("").map(function (c) { return '<span class="gc" style="--i:' + (k++) + '">' + c + "</span>"; }).join("") + "</span>";
    }).join(" ");
  });

  // ---- split statements into words (keeps <em>) ----
  function wrapWords(node) {
    $$("*", node).concat([node]).forEach(function (el) {
      Array.prototype.slice.call(el.childNodes).forEach(function (n) {
        if (n.nodeType !== 3 || !n.nodeValue.trim()) return;
        var frag = document.createDocumentFragment();
        n.nodeValue.split(/(\s+)/).forEach(function (part) {
          if (!part) return;
          if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
          var s = document.createElement("span"); s.className = "w"; s.textContent = part; frag.appendChild(s);
        });
        el.replaceChild(frag, n);
      });
    });
  }
  var statements = $$(".wreveal");
  statements.forEach(wrapWords);

  // ---- one-shot reveals ----
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { (e.target._rv || e.target).classList.add("in"); io.unobserve(e.target); } });
  }, { root: scroller === window ? null : scroller, threshold: 0.2 });
  $$(".giant[data-split]").forEach(function (el) { io.observe(el); });
  // a clipped element never counts as visible, so watch its parent instead
  $$(".clipin").forEach(function (el) { var h = el.parentElement; h._rv = el; io.observe(h); });

  // ---- statements: once one is on screen, its words fill in one after another on their own
  // (no need to keep scrolling), and they stay filled ----
  function fillWords(el) {
    if (el._filled) return; el._filled = true;
    var ws = el.querySelectorAll(".w");
    for (var i = 0; i < ws.length; i++) (function (w, d) { setTimeout(function () { w.classList.add("on"); }, d); })(ws[i], 150 + i * 42);
  }
  if ("IntersectionObserver" in window) {
    var wio = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { fillWords(e.target); wio.unobserve(e.target); } });
    }, { root: scroller === window ? null : scroller, threshold: 0.3 });
    statements.forEach(function (el) { wio.observe(el); });
  } else statements.forEach(fillWords);

  // ---- scroll-linked: band photo parallax ----
  var plx = $$(".parallax");
  var ticking = false;
  function onScroll() {
    if (ticking) return; ticking = true;
    requestAnimationFrame(function () {
      ticking = false;
      var vh = window.innerHeight;
      if (!reduce) plx.forEach(function (img) {
        var host = img.parentElement.getBoundingClientRect();
        if (host.bottom < 0 || host.top > vh) return;
        var t = (host.top + host.height / 2 - vh / 2) / (vh + host.height);
        img.style.transform = "translate3d(0," + (t * -14).toFixed(2) + "%,0)";
      });
    });
  }
  (scroller === window ? window : scroller).addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();
  if (reduce) statements.forEach(function (el) { $$(".w", el).forEach(function (w) { w.classList.add("on"); }); });

  // ---- lists with a swapping image ----
  function activate(list, i, viaFocus) {
    var items = $$(".bl-item", list);
    if (!items[i] || items[i].classList.contains("is-on")) return;
    items.forEach(function (b, k) {
      var on = k === i; b.classList.toggle("is-on", on); b.setAttribute("aria-selected", on ? "true" : "false"); b.tabIndex = on ? 0 : -1;
      var panel = document.getElementById(b.getAttribute("aria-controls"));
      if (panel) { panel.hidden = !on; panel.classList.toggle("is-on", on); }
    });
    var media = document.getElementById(list.getAttribute("data-media"));
    if (media) {
      var figs = $$(".bl-fig", media);
      figs.forEach(function (f, k) { f.classList.remove("was"); if (f.classList.contains("is-on") && k !== i) { f.classList.remove("is-on"); f.classList.add("was"); } });
      if (figs[i]) figs[i].classList.add("is-on");
      setTimeout(function () { figs.forEach(function (f) { if (!f.classList.contains("is-on")) f.classList.remove("was"); }); }, 1200);
      var c = $(".bl-count b", media);
      if (c) { var t = items[i].querySelector("i"); c.textContent = t ? t.textContent : String(i + 1).padStart(2, "0"); }
    }
    if (viaFocus) items[i].focus();
  }
  $$(".blist").forEach(function (list) {
    var items = $$(".bl-item", list);
    items.forEach(function (b, k) {
      b.tabIndex = b.classList.contains("is-on") ? 0 : -1;
      b.addEventListener("click", function () { activate(list, k); });
      if (fine) b.addEventListener("mouseenter", function () { activate(list, k); });
      b.addEventListener("keydown", function (e) {
        var n = items.length, j = null;
        if (e.key === "ArrowDown" || e.key === "ArrowRight") j = (k + 1) % n;
        if (e.key === "ArrowUp" || e.key === "ArrowLeft") j = (k - 1 + n) % n;
        if (e.key === "Home") j = 0; if (e.key === "End") j = n - 1;
        if (j !== null) { e.preventDefault(); activate(list, j, true); }
      });
    });
  });
  // menu links straight to a service (#management, #investment, #sales) open that tab
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest('a[href^="#"]');
    if (!a) return;
    var id = a.getAttribute("href").slice(1), panel = id && document.getElementById(id);
    if (!panel || !panel.classList.contains("bl-panel")) return;
    var tab = document.querySelector('.bl-item[aria-controls="' + id + '"]');
    if (!tab) return;
    var list = tab.closest(".blist"), items = $$(".bl-item", list);
    activate(list, items.indexOf(tab));
    var sec = list.closest("section");
    if (sec) { e.preventDefault(); if (window.rfrScrollTo) window.rfrScrollTo(sec, reduce); else sec.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" }); }
  }, true);

  // ---- floating cards drift with the mouse ----
  if (fine && !reduce) {
    var floats = $$(".float"), mx = 0, my = 0, cx = 0, cy = 0, running = false;
    window.addEventListener("mousemove", function (e) {
      mx = e.clientX / window.innerWidth - 0.5; my = e.clientY / window.innerHeight - 0.5;
      if (!running) { running = true; requestAnimationFrame(tick); }
    }, { passive: true });
    function tick() {
      cx += (mx - cx) * 0.07; cy += (my - cy) * 0.07;
      var vh = window.innerHeight;
      floats.forEach(function (el) {
        var r = el.getBoundingClientRect(); if (r.bottom < 0 || r.top > vh) return;
        var d = +(el.getAttribute("data-depth") || 16);
        el.style.translate = (cx * d).toFixed(2) + "px " + (cy * d).toFixed(2) + "px";
      });
      if (Math.abs(mx - cx) > 0.0005 || Math.abs(my - cy) > 0.0005) requestAnimationFrame(tick); else running = false;
    }
  }
})();

