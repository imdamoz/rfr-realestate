<script is:inline>
/* RFR cursor trails: the Belgrade Arbor hover effect, same physics, colour and opacity.
   10 spring trails x 10 nodes, 1px muted gold at 20%, drawn with "lighter".
   Shown at 1121px and wider (as on their site); off with reduced motion; idles when still. */
(function () {
  "use strict";
  var mq = window.matchMedia("(min-width: 1121px)");
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  var E = { friction: 0.5, trails: 10, size: 10, dampening: 0.1, tension: 0.98 };
  var cv = null, ctx = null, lines = [], pos = { x: 0, y: 0 }, started = false, running = false, settled = 0;

  function Node() { this.x = 0; this.y = 0; this.vx = 0; this.vy = 0; }
