---
// Shared shell for every subpage (not the homepage, which has its own
// template because of its homepage-only critical CSS/JS). Mirrors the
// <head> and header/footer/drawer markup that's identical across
// about.html, services.html, buy-sell-lease.html, market.html, areas.html,
// listings.html and off-plan.html on the original static site.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import SideMenu from "../components/SideMenu.astro";

const { page, title, description, path, ldJson = [] } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<SEOHead title={title} description={description} path={path} ldJson={ldJson} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap">
<link rel="stylesheet" href="site.css">
<slot name="head" />
</head>
<body class:list={["sub", `page-${page}`]}>
<Header page={page} />
<div id="scroller">
<main id="top">
<slot />
<Footer page={page} />
</main>
</div>
<SideMenu page={page} />
<slot name="after-menu" />
<slot name="pre-script" />
<script src="site.js" is:inline></script>
</body>
</html>
